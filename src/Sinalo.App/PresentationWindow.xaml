<Window
  x:Class="Sinalo.App.PresentationWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Sinalo — Apresentação"
  WindowStyle="None"
  ResizeMode="NoResize"
  ShowInTaskbar="False"
  Topmost="True"
  PreviewKeyDown="PresentationWindow_PreviewKeyDown"
  Background="#0F172A">
  <Grid
    x:Name="PresentationSafeArea"
    Margin="48">
    <Grid.RowDefinitions>
      <RowDefinition
        Height="Auto" />
      <RowDefinition
        Height="*" />
      <RowDefinition
        Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock
      Text="{Binding Title}"
      Foreground="#CBD5E1"
      FontSize="28"
      HorizontalAlignment="Center"
      TextAlignment="Center" />
    <Viewbox
      Grid.Row="1"
      Stretch="Uniform"
      StretchDirection="Both"
      Margin="0,32">
      <TextBlock
        Text="{Binding MainText}"
        Foreground="#F8FAFC"
        FontSize="96"
        FontWeight="SemiBold"
        TextWrapping="Wrap"
        TextAlignment="Center"
        Width="840" />
    </Viewbox>
    <StackPanel
      Grid.Row="2">
      <TextBlock
        Text="{Binding SecondaryText}"
        Foreground="#5EEAD4"
        FontSize="24"
        TextWrapping="Wrap"
        TextAlignment="Center" />
      <TextBlock
        x:Name="EscapeInstruction"
        Text="Pressione Esc para fechar"
        Foreground="#CBD5E1"
        FontSize="16"
        TextAlignment="Center"
        Margin="0,16,0,0"
        Visibility="Collapsed" />
    </StackPanel>
  </Grid>
</Window>