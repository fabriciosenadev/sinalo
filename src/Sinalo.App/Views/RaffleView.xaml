<UserControl
  x:Class="Sinalo.App.Views.RaffleView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <BooleanToVisibilityConverter
      x:Key="BooleanToVisibilityConverter" />
  </UserControl.Resources>
  <ScrollViewer
    VerticalScrollBarVisibility="Auto"
    HorizontalScrollBarVisibility="Disabled"
    Padding="0,0,12,0">
    <StackPanel>
      <TextBlock
        Text="Cadastre participantes e escolha um vencedor sem repetição."
        Foreground="{DynamicResource Brush.TextSecondary}"
        Margin="0,4,0,24" />
      <Border
        Background="{DynamicResource Brush.Surface}"
        BorderBrush="{DynamicResource Brush.Border}"
        BorderThickness="1"
        CornerRadius="12"
        Padding="20">
        <StackPanel>
          <TextBlock
            Text="{Binding Raffle.CurrentWinner}"
            FontSize="64"
            FontWeight="SemiBold"
            Foreground="{DynamicResource Brush.Accent}"
            HorizontalAlignment="Center"
            TextWrapping="Wrap"
            TextAlignment="Center" />
          <TextBlock
            Text="{Binding Raffle.StatusLabel}"
            Foreground="{DynamicResource Brush.TextSecondary}"
            HorizontalAlignment="Center"
            Margin="0,4,0,18" />
          <WrapPanel
            Orientation="Horizontal"
            HorizontalAlignment="Center">
            <TextBlock
              Text="Disponíveis: "
              Foreground="{DynamicResource Brush.TextSecondary}" />
            <TextBlock
              Text="{Binding Raffle.AvailableCount}"
              Foreground="{DynamicResource Brush.TextPrimary}"
              FontWeight="SemiBold" />
            <TextBlock
              Text="   Sorteados: "
              Foreground="{DynamicResource Brush.TextSecondary}" />
            <TextBlock
              Text="{Binding Raffle.DrawnCount}"
              Foreground="{DynamicResource Brush.TextPrimary}"
              FontWeight="SemiBold" />
          </WrapPanel>
          <WrapPanel
            Margin="0,16,0,0">
            <Button
              Content="Abrir apresentação do sorteio"
              Click="OpenRafflePresentation_Click"
              Style="{DynamicResource Button.Primary}"
              Margin="0,0,8,8"
              VerticalAlignment="Center" />
          </WrapPanel>
          <Separator
            Margin="0,20" />
          <TabControl
            IsEnabled="{Binding Raffle.CanEdit}"
            Margin="0,0,0,16">
            <TabItem
              Header="Nomes">
              <StackPanel>
                <TextBlock
                  Text="Adicionar nome"
                  Foreground="{DynamicResource Brush.TextSecondary}" />
                <DockPanel
                  Margin="0,5,0,12">
                  <Button
                    Content="Adicionar"
                    Tag="name"
                    IsEnabled="{Binding Raffle.CanEdit}"
                    Click="RaffleAction_Click"
                    DockPanel.Dock="Right"
                    Margin="8,0,0,0" />
                  <TextBox
                    Text="{Binding Raffle.NameToAdd, UpdateSourceTrigger=PropertyChanged}"
                    Padding="8" />
                </DockPanel>
              </StackPanel>
            </TabItem>
            <TabItem
              Header="Números">
              <StackPanel>
                <TextBlock
                  Text="Adicionar intervalo numérico"
                  Foreground="{DynamicResource Brush.TextSecondary}" />
                <WrapPanel
                  Orientation="Horizontal"
                  Margin="0,5,0,12">
                  <TextBlock
                    Text="De"
                    VerticalAlignment="Center"
                    Margin="0,0,8,8" />
                  <TextBox
                    AutomationProperties.Name="Número inicial"
                    Height="40"
                    Margin="0,0,8,8"
                    Text="{Binding Raffle.RangeStart, UpdateSourceTrigger=PropertyChanged}"
                    Padding="8"
                    Width="150" />
                  <TextBlock
                    Text="Até"
                    VerticalAlignment="Center"
                    Margin="0,0,8,8" />
                  <TextBox
                    AutomationProperties.Name="Número final"
                    Height="40"
                    Text="{Binding Raffle.RangeEnd, UpdateSourceTrigger=PropertyChanged}"
                    Padding="8"
                    Width="150"
                    Margin="0,0,8,8" />
                  <Button
                    Content="Adicionar"
                    Tag="range"
                    Click="RaffleAction_Click"
                    Margin="0,0,8,8"
                    VerticalAlignment="Center" />
                </WrapPanel>
              </StackPanel>
            </TabItem>
          </TabControl>
          <WrapPanel
            Orientation="Horizontal">
            <Button
              Content="Sortear"
              IsEnabled="{Binding Raffle.CanStart}"
              Tag="start"
              Click="RaffleAction_Click"
              Style="{DynamicResource Button.Primary}"
              Margin="0,0,8,8"
              VerticalAlignment="Center" />
            <Button
              Content="Limpar resultado"
              ToolTip="Preserva todos os participantes e os sorteados"
              Tag="display"
              Click="RaffleAction_Click"
              Margin="0,0,8,8"
              VerticalAlignment="Center" />
            <Button
              Content="Reiniciar sorteio"
              ToolTip="Todos os participantes voltam a ficar disponíveis"
              Tag="restart"
              Click="RaffleAction_Click"
              Margin="0,0,8,8"
              VerticalAlignment="Center" />
            <Button
              Content="Remover participantes"
              ToolTip="Apaga participantes e resultado"
              Tag="clear"
              Click="RaffleAction_Click"
              Margin="0,0,8,8"
              VerticalAlignment="Center" />
          </WrapPanel>
          <Grid
            Margin="0,22,0,0"
            MaxHeight="300">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock
                Text="Disponíveis"
                FontWeight="SemiBold"
                Foreground="{DynamicResource Brush.TextPrimary}" />
              <ListBox
                ItemsSource="{Binding Raffle.Available}"
                ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock
                      Text="{Binding Label}"
                      Foreground="{DynamicResource Brush.TextSecondary}"
                      Margin="0,3" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>
            <StackPanel
              Grid.Column="1">
              <TextBlock
                Text="Sorteados"
                FontWeight="SemiBold"
                Foreground="{DynamicResource Brush.TextPrimary}" />
              <ListBox
                ItemsSource="{Binding Raffle.Drawn}"
                ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock
                      Text="{Binding Label}"
                      Foreground="{DynamicResource Brush.TextSecondary}"
                      Margin="0,3" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
