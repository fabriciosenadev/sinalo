<UserControl x:Class="Sinalo.App.Views.LouvorJaIntegrationView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{DynamicResource Brush.Window}" Foreground="{DynamicResource Brush.TextPrimary}">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
  <Style x:Key="Panel" TargetType="Border">
   <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
   <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="16"/><Setter Property="Margin" Value="0,0,0,16"/>
  </Style>
 </UserControl.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,16">
   <TextBlock Text="{Binding PageTitle}" Style="{DynamicResource Text.Heading}"/>
   <Border Style="{StaticResource Panel}" BorderBrush="{DynamicResource Brush.Accent}" Margin="0,12,0,0">
    <TextBlock Text="{Binding SafetyNotice}" TextWrapping="Wrap" FontWeight="SemiBold"/>
   </Border>
  </StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0">
   <StackPanel>
    <Border Style="{StaticResource Panel}"><StackPanel>
     <TextBlock Text="1. Conexão" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
     <StackPanel Visibility="{Binding IsReal, Converter={StaticResource BoolVisibility}}">
      <TextBlock Text="Executável do Louvor JA" Margin="0,0,0,4"/>
      <DockPanel><Button DockPanel.Dock="Right" Content="Escolher executável…" Click="ChooseExecutable_Click" IsEnabled="{Binding CanConnect}" Margin="8,0,0,0"/>
       <TextBox Text="{Binding ExecutablePath, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanConnect}" AutomationProperties.Name="Executável do Louvor JA"/></DockPanel>
      <TextBlock Text="Padrão: pasta Programs\Louvor JA do seu perfil do Windows. Se instalado em outro local, selecione Louvor JA.exe e salve." TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,6,0,0"/>
      <Button Content="Abrir Louvor JA" Command="{Binding LaunchCommand}" HorizontalAlignment="Left" Margin="0,8,0,6"/>
      <TextBlock Text="Ao abrir, o Sinalo aguarda até 30 segundos e conecta automaticamente, sem iniciar músicas. Se o Louvor JA já estiver aberto ao iniciar o Sinalo, a conexão também é verificada." TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,0,12"/>
      <TextBlock Text="Porta do servidor local" Margin="0,0,0,4"/>
      <TextBox Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanConnect}" MaxLength="5" Width="110" HorizontalAlignment="Left" AutomationProperties.Name="Porta do Louvor JA"/>
      <TextBlock Text="{Binding EndpointLabel}" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,8,0,8"/>
      <WrapPanel><Button Content="Salvar caminho e porta" Command="{Binding SaveConfigurationCommand}"/><Button Content="Restaurar caminho padrão" Command="{Binding RestoreDefaultPathCommand}"/></WrapPanel>
      <TextBlock Text="No Louvor JA: Configurações → Transmissão (OBS / vMix). Selecione Localhost (apenas este computador), ative o servidor e confira a porta. O Sinalo não altera essas configurações." TextWrapping="Wrap" Margin="0,0,0,12"/>
     </StackPanel>
     <StackPanel Visibility="{Binding IsSimulation, Converter={StaticResource BoolVisibility}}">
     <TextBlock Text="Cenário de teste" Margin="0,0,0,4"/>
     <ComboBox x:Name="ScenarioSelector" ItemsSource="{Binding Scenarios}" SelectedItem="{Binding SelectedScenario}" IsEnabled="{Binding CanChangeScenario}" AutomationProperties.Name="Cenário de teste">
      <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate>
     </ComboBox>
     </StackPanel>
     <TextBlock Text="{Binding ConnectionLabel}" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,12,0,8"/>
     <WrapPanel><Button x:Name="ConnectButton" Content="{Binding ConnectCaption}" Command="{Binding ConnectCommand}" Style="{DynamicResource Button.Primary}"/>
      <Button Content="Desconectar" Command="{Binding DisconnectCommand}" Visibility="{Binding IsReal, Converter={StaticResource BoolVisibility}}"/>
      <Button Content="Reiniciar cenário" Command="{Binding ResetCommand}" Visibility="{Binding IsSimulation, Converter={StaticResource BoolVisibility}}"/><Button Content="Cancelar espera" Command="{Binding CancelCommand}"/></WrapPanel>
    </StackPanel></Border>
    <Border Style="{StaticResource Panel}"><StackPanel>
     <TextBlock Text="2. Catálogo de músicas" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
     <TextBlock Text="Pesquisar por nome, número do hino ou trecho da letra" TextWrapping="Wrap" Margin="0,0,0,4"/>
     <DockPanel><Button DockPanel.Dock="Right" Content="Pesquisar" Command="{Binding SearchCommand}" Margin="8,0,0,0"/>
      <TextBox x:Name="SearchInput" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditSearch}" AutomationProperties.Name="Pesquisar música">
       <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SearchCommand}"/></TextBox.InputBindings>
      </TextBox></DockPanel>
     <TextBlock Text="Busca automática ao terminar de digitar. Enter ou Pesquisar consultam imediatamente." TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,6,0,0"/>
     <ProgressBar Height="3" IsIndeterminate="{Binding IsSearching}" Visibility="{Binding IsSearching, Converter={StaticResource BoolVisibility}}" Margin="0,8,0,4"/>
     <TextBlock Text="{Binding SearchStatus}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,6,0,0"/>
     <ListBox x:Name="SongList" ItemsSource="{Binding Songs}" SelectedItem="{Binding SelectedSong}" Height="150" Margin="0,12,0,0" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" Foreground="{DynamicResource Brush.TextPrimary}" IsEnabled="{Binding CanRefresh}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Músicas do catálogo">
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="10"/><Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/><Setter Property="Background" Value="Transparent"/>
       <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource Brush.Selection}"/><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/></Trigger></ControlTemplate.Triggers>
       </ControlTemplate></Setter.Value></Setter>
      </Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Artist}" Foreground="{DynamicResource Brush.TextSecondary}"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <TextBlock Text="Modo de abertura" Margin="0,12,0,4"/>
     <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}" IsEnabled="{Binding CanRefresh}" AutomationProperties.Name="Modo de abertura">
      <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate>
     </ComboBox>
     <TextBlock Text="Instrumental exige uma música que declare esse recurso." TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,8,0,8"/>
     <Button x:Name="OpenButton" Content="Abrir música no Louvor JA" Command="{Binding OpenCommand}" Style="{DynamicResource Button.Primary}" HorizontalAlignment="Left"/>
    </StackPanel></Border>
    <Border Style="{StaticResource Panel}"><StackPanel>
     <TextBlock Text="3. Controle do Louvor JA" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12"/>
     <TextBlock Text="{Binding PresentationTitle}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
     <TextBlock Text="{Binding StateLabel}" Margin="0,8,0,8" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}"/>
     <TextBlock Text="{Binding State.CurrentLyric}" TextWrapping="Wrap" Margin="0,0,0,12"/>
     <WrapPanel><Button Content="Reproduzir / pausar" Command="{Binding ToggleCommand}"/><Button Content="Slide anterior" Command="{Binding PreviousCommand}"/>
      <Button Content="Próximo slide" Command="{Binding NextCommand}"/><Button Content="Encerrar música" Command="{Binding CloseCommand}"/><Button Content="Consultar estado" Command="{Binding RefreshCommand}"/></WrapPanel>
     <TextBlock Text="Volume solicitado (0–100)" Margin="0,8,0,4"/>
     <DockPanel><Button DockPanel.Dock="Right" Content="Aplicar volume" Command="{Binding ApplyVolumeCommand}" Margin="8,0,0,0"/>
      <Slider Minimum="0" Maximum="100" Value="{Binding RequestedVolume}" TickFrequency="1" IsSnapToTickEnabled="True" IsEnabled="{Binding CanControl}" AutomationProperties.Name="Volume do Louvor JA"/></DockPanel>
    </StackPanel></Border>
    <Border Style="{StaticResource Panel}"><StackPanel>
     <TextBlock Text="4. Diagnóstico do protocolo" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
     <TextBlock Text="Solicitações e respostas, mais recentes primeiro. Limite de 100 entradas em memória; nada é gravado em disco." TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,0,12"/>
     <ListBox ItemsSource="{Binding Diagnostics}" Height="190" Background="{DynamicResource Brush.Surface}" Foreground="{DynamicResource Brush.TextPrimary}" BorderBrush="{DynamicResource Brush.Border}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"/></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </StackPanel></Border>
    <TextBlock Text="Bíblia, liturgia, cronômetro e sorteio não são controlados nesta etapa. Os monitores são configurados no Louvor JA. Desconectar ou fechar o Sinalo não encerra a reprodução no Louvor JA; use Encerrar música antes." TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,0,16"/>
   </StackPanel>
  </ScrollViewer>
  <StackPanel Grid.Row="2" Margin="0,8,0,0"><ProgressBar x:Name="OperationProgress" Height="4" IsIndeterminate="{Binding IsWorking}" Visibility="{Binding IsWorking, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,8"/>
   <TextBlock x:Name="ResultMessage" Text="{Binding Message}" TextWrapping="Wrap"/></StackPanel>
 </Grid>
</UserControl>
