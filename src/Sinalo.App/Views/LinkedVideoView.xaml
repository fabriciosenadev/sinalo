<UserControl
  x:Class="Sinalo.App.Views.LinkedVideoView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <BooleanToVisibilityConverter
      x:Key="BooleanToVisibilityConverter" />
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition
        Height="*" />
      <RowDefinition
        Height="Auto" />
    </Grid.RowDefinitions>
    <ScrollViewer
      VerticalScrollBarVisibility="Auto"
      HorizontalScrollBarVisibility="Disabled"
      Padding="0,0,12,0">
      <StackPanel>
        <TextBlock
          Text="Consulte o vídeo, escolha o programa e adicione o download à fila."
          Foreground="{DynamicResource Brush.TextSecondary}"
          Margin="0,4,0,24"
          TextWrapping="Wrap" />
        <Border
          Background="{DynamicResource Brush.Surface}"
          BorderBrush="{DynamicResource Brush.Border}"
          BorderThickness="1"
          CornerRadius="12"
          Padding="20">
          <StackPanel>
            <TextBlock
              Text="1. Consultar vídeo — link"
              Foreground="{DynamicResource Brush.TextPrimary}"
              Margin="0,0,0,5" />
            <StackPanel>
              <TextBox
                AutomationProperties.Name="Link do vídeo"
                Text="{Binding LinkedVideoUrl, UpdateSourceTrigger=PropertyChanged}"
                Padding="8"
                Margin="0,0,0,8" />
              <Button
                HorizontalAlignment="Left"
                Content="Consultar vídeo"
                Click="InspectLinkedVideo_Click"
                DockPanel.Dock="Right"
                Margin="0,0,8,8"
                IsEnabled="{Binding CanInspectLinkedVideo}" />
            </StackPanel>
            <TextBlock
              Text="{Binding LinkedVideoStatus}"
              Foreground="{DynamicResource Brush.TextSecondary}"
              TextWrapping="Wrap"
              Margin="0,10,0,0" />
            <StackPanel
              Visibility="{Binding HasLinkedVideo, Converter={StaticResource BooleanToVisibilityConverter}}">
              <TextBlock
                Text="{Binding LinkedVideoTitle}"
                FontSize="18"
                FontWeight="SemiBold"
                Foreground="{DynamicResource Brush.TextPrimary}"
                TextWrapping="Wrap"
                Margin="0,20,0,0" />
              <TextBlock
                Text="{Binding LinkedVideoPublishedDate}"
                Foreground="{DynamicResource Brush.TextSecondary}"
                Margin="0,4,0,0" />
              <TextBlock
                Text="2. Preparar download — qualidade MP4"
                Foreground="{DynamicResource Brush.TextPrimary}"
                Margin="0,20,0,5" />
              <ComboBox
                ItemsSource="{Binding LinkedVideoFormats}"
                SelectedItem="{Binding SelectedLinkedVideoFormat}"
                Padding="8">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock
                      Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock
                Text="3. Destino — salvar no programa"
                Foreground="{DynamicResource Brush.TextPrimary}"
                Margin="0,20,0,5" />
              <ComboBox
                ItemsSource="{Binding LinkedVideoDestinations}"
                SelectedItem="{Binding SelectedLinkedVideoDestination}"
                Padding="8">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock
                      Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock
                Text="Data de uso (DD/MM/AAAA)"
                Foreground="{DynamicResource Brush.TextPrimary}"
                Margin="0,20,0,5" />
              <TextBox
                Text="{Binding LinkedVideoDateText, UpdateSourceTrigger=PropertyChanged}"
                Padding="8"
                ToolTip="Informe a data da programação; ela pode ser diferente da publicação do vídeo" />
              <TextBlock
                Text="O vídeo só aparecerá como pronto offline após o download e a validação do arquivo. A adição por link não altera a busca automática do programa."
                Foreground="{DynamicResource Brush.TextSecondary}"
                TextWrapping="Wrap"
                Margin="0,15,0,0" />
              <TextBlock
                Text="{Binding LinkedVideoSummary}"
                Margin="0,16,0,0" />
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <WrapPanel
      Grid.Row="1"
      Margin="0,12,0,0"
      HorizontalAlignment="Right">
      <Button
        Content="Ver downloads"
        Click="OpenDownloads_Click"
        Margin="0,0,8,8"
        VerticalAlignment="Center" />
      <Button
        Content="Adicionar à fila"
        Click="QueueLinkedVideo_Click"
        IsEnabled="{Binding CanQueueLinkedVideo}"
        Style="{DynamicResource Button.Primary}"
        HorizontalAlignment="Right"
        Margin="0,0,8,8"
        VerticalAlignment="Center" />
    </WrapPanel>
  </Grid>
</UserControl>
