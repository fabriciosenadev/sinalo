<Window x:Class="Sinalo.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sinalo" Height="720" Width="1280" MinHeight="580" MinWidth="940"
        Background="{DynamicResource Brush.Window}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="290" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.ColumnSpan="3" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Sinalo" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" />
                        <Border Background="{DynamicResource Brush.SurfaceRaised}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ApplicationVersion}" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Conteúdos prontos para a programação da igreja" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <Button Content="Configurações" Padding="14,8" Click="ConfigureSources_Click" Style="{DynamicResource Button.Busy}" HorizontalAlignment="Right" />
                    <Border Background="{DynamicResource Brush.SurfaceRaised}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,8,0,0" Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Width="250">
                            <TextBlock Text="{Binding UpdateMessage}" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" FontSize="11" />
                            <ProgressBar Height="6" Margin="0,6,0,0" Minimum="0" Maximum="100" Value="{Binding UpdateProgressPercent}" Visibility="{Binding IsUpdateDownloading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Content="Atualizar e reiniciar" Click="InstallUpdate_Click" Padding="10,6" Margin="0,7,0,0" Style="{DynamicResource Button.Primary}" IsEnabled="{Binding IsUpdateReady}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.ColumnSpan="3" Background="{DynamicResource Brush.Header}" BorderBrush="{DynamicResource Brush.HeaderBorder}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Sábado anterior" Foreground="{DynamicResource Brush.HeaderLabel}" /><TextBlock Text="{Binding PreviousSaturday}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" /></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock Text="Sábado atual" Foreground="{DynamicResource Brush.HeaderLabel}" /><TextBlock Text="{Binding CurrentSaturday}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}" /></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="Próximo sábado" Foreground="{DynamicResource Brush.HeaderLabel}" /><TextBlock Text="{Binding NextSaturday}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" /></StackPanel>
                <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" Width="350"><TextBlock Text="{Binding OperationMessage}" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" HorizontalAlignment="Right" /><ProgressBar Height="8" Margin="0,7,0,0" Minimum="0" Maximum="100" Value="{Binding SyncProgressPercent}" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" /></StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,14,0">
            <StackPanel>
                <TextBlock Text="Navegação" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" />
                <TextBlock Text="CONTEÚDOS" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold" FontSize="11" Margin="0,20,0,7" />
                <ItemsControl ItemsSource="{Binding Sources}"><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Name}" Tag="{Binding Name}" Click="SourceFilter_Click" Padding="8" ToolTip="{Binding Status}" Style="{DynamicResource Button.Navigation}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <Separator Margin="0,18,0,14" />
                <TextBlock Text="FERRAMENTAS DE APRESENTAÇÃO" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,7" />
                <Button Content="Cronômetro" Click="TimerWorkspace_Click" Padding="8" Style="{DynamicResource Button.Navigation}" ToolTip="Controle de tempo para a programação" />
                <Button Content="Sorteio" Click="RaffleWorkspace_Click" Padding="8" Style="{DynamicResource Button.Navigation}" ToolTip="Sorteio de números e nomes" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Grid.Column="1" Margin="0,0,14,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,12" Visibility="{Binding IsLibraryWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="Vídeos" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" DockPanel.Dock="Left" />
                <StackPanel Width="250" DockPanel.Dock="Right">
                    <Label Content="Pesquisar vídeos" Target="{Binding ElementName=CatalogSearchBox}" Foreground="{DynamicResource Brush.TextSecondary}" Padding="0,0,0,4" />
                    <TextBox x:Name="CatalogSearchBox" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Padding="8" ToolTip="Pesquise pelo nome do vídeo ou pela data, por exemplo 15/08/2026" />
                </StackPanel>
            </DockPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsLibraryWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}"><ItemsControl ItemsSource="{Binding CatalogItems}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Tag="{Binding}" Click="CatalogItem_Click" MouseDoubleClick="CatalogItem_DoubleClick" Padding="0" Margin="0,0,12,12" Style="{DynamicResource Button.Card}"><Border Width="205" Background="{DynamicResource Brush.SurfaceRaised}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="10" Padding="12"><StackPanel><Border Height="96" Background="{DynamicResource Brush.Thumbnail}" CornerRadius="7"><TextBlock Text="{Binding ThumbnailGlyph}" FontSize="34" Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,10,0,0" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding SourceName}" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" /><DockPanel Margin="0,8,0,0"><TextBlock Text="{Binding ScheduledDate}" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12" /><TextBlock Text="{Binding Status}" Foreground="{DynamicResource Brush.Warning}" FontSize="12" HorizontalAlignment="Right" /></DockPanel><TextBlock Text="{Binding PlaybackLabel}" Foreground="{DynamicResource Brush.Accent}" FontSize="11" Margin="0,6,0,0" /></StackPanel></Border></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
            <ScrollViewer Grid.RowSpan="2" Visibility="{Binding IsTimerWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel><TextBlock Text="Cronômetro" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" /><TextBlock Text="Controle a apresentação da programação." Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,4,0,24" /><Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="12" Padding="28"><StackPanel><TextBlock Text="{Binding Timer.DisplayTime}" FontSize="72" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center" /><TextBlock Text="{Binding Timer.StateLabel}" Foreground="{DynamicResource Brush.TextSecondary}" HorizontalAlignment="Center" Margin="0,4,0,20" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button Content="{Binding Timer.StartPauseLabel}" Click="TimerStartPause_Click" Padding="18,10" Style="{DynamicResource Button.Primary}" /><Button Content="Parar/Zerar" Click="TimerReset_Click" Padding="18,10" Margin="10,0" /></StackPanel><TextBlock Text="Direção" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,24,0,4" /><ComboBox ItemsSource="{Binding Timer.Directions}" SelectedItem="{Binding Timer.SelectedDirection}" SelectionChanged="TimerConfiguration_SelectionChanged" Padding="8"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBlock Text="Duração regressiva (HH:MM:SS)" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,12,0,4" /><TextBox Text="{Binding Timer.CountdownDurationText, UpdateSourceTrigger=PropertyChanged}" LostFocus="TimerConfiguration_Changed" IsEnabled="{Binding Timer.IsCountdown}" Padding="8" /><TextBlock Text="Formato" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,12,0,4" /><ComboBox ItemsSource="{Binding Timer.DisplayFormats}" SelectedItem="{Binding Timer.SelectedFormat}" SelectionChanged="TimerConfiguration_SelectionChanged" Padding="8"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel></Border></StackPanel></ScrollViewer>
            <ScrollViewer Grid.RowSpan="2" Visibility="{Binding IsRaffleWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel><TextBlock Text="Sorteio" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" /><TextBlock Text="Cadastre participantes e escolha um vencedor sem repetição." Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,4,0,24" /><Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="12" Padding="28"><StackPanel><TextBlock Text="{Binding Raffle.CurrentWinner}" FontSize="64" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Raffle.StatusLabel}" Foreground="{DynamicResource Brush.TextSecondary}" HorizontalAlignment="Center" Margin="0,4,0,18" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="Disponíveis: " Foreground="{DynamicResource Brush.TextSecondary}" /><TextBlock Text="{Binding Raffle.AvailableCount}" Foreground="{DynamicResource Brush.TextPrimary}" FontWeight="SemiBold" /><TextBlock Text="   Sorteados: " Foreground="{DynamicResource Brush.TextSecondary}" /><TextBlock Text="{Binding Raffle.DrawnCount}" Foreground="{DynamicResource Brush.TextPrimary}" FontWeight="SemiBold" /></StackPanel><Separator Margin="0,20" /><TextBlock Text="Adicionar nome" Foreground="{DynamicResource Brush.TextSecondary}" /><DockPanel Margin="0,5,0,12"><Button Content="Adicionar" Tag="name" Click="RaffleAction_Click" DockPanel.Dock="Right" Padding="12,8" Margin="8,0,0,0" /><TextBox Text="{Binding Raffle.NameToAdd, UpdateSourceTrigger=PropertyChanged}" Padding="8" /></DockPanel><TextBlock Text="Adicionar intervalo numérico" Foreground="{DynamicResource Brush.TextSecondary}" /><StackPanel Orientation="Horizontal" Margin="0,5,0,12"><TextBox Text="{Binding Raffle.RangeStart, UpdateSourceTrigger=PropertyChanged}" Padding="8" Width="150" /><TextBox Text="{Binding Raffle.RangeEnd, UpdateSourceTrigger=PropertyChanged}" Padding="8" Width="150" Margin="8,0" /><Button Content="Adicionar" Tag="range" Click="RaffleAction_Click" Padding="12,8" /></StackPanel><StackPanel Orientation="Horizontal"><Button Content="Sortear" Tag="start" Click="RaffleAction_Click" Padding="18,10" Style="{DynamicResource Button.Primary}" /><Button Content="Reiniciar exibição" Tag="display" Click="RaffleAction_Click" Padding="12,10" Margin="8,0" /><Button Content="Reiniciar sorteio" Tag="restart" Click="RaffleAction_Click" Padding="12,10" /><Button Content="Zerar" Tag="clear" Click="RaffleAction_Click" Padding="12,10" Margin="8,0" /></StackPanel><Grid Margin="0,22,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Disponíveis" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" /><ItemsControl ItemsSource="{Binding Raffle.Available}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,3" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Sorteados" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" /><ItemsControl ItemsSource="{Binding Raffle.Drawn}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,3" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Grid></StackPanel></Border></StackPanel></ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Grid.Column="2" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="10" Padding="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                <TextBlock Text="Ações da fonte" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" />
                <TextBlock Text="{Binding SelectedSourceActionLabel}" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" Margin="0,12,0,6" />
                <Button Content="{Binding UpdateAndSynchronizeSelectedSourceLabel}" Click="UpdateAndSynchronizeSelectedSource_Click" Padding="8" IsEnabled="{Binding CanQueueSelectedSource}" Style="{DynamicResource Button.Primary}" />
                <TextBlock Text="A solicitação entra em uma fila única para não sobrecarregar o computador." Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0" />
                <Separator Margin="0,18,0,14" />
                <TextBlock Text="Fila de sincronização" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" />
                <ItemsControl ItemsSource="{Binding SynchronizationQueueItems}" Margin="0,10,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource Brush.SurfaceRaised}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,7">
                                <StackPanel>
                                    <DockPanel><TextBlock Text="{Binding SourceName}" Foreground="{DynamicResource Brush.TextPrimary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding State}" Foreground="{DynamicResource Brush.Accent}" FontSize="11" HorizontalAlignment="Right" /></DockPanel>
                                    <TextBlock Text="{Binding Details}" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Cancelar fila" Click="CancelSynchronizationQueue_Click" IsEnabled="{Binding IsQueueActive}" Padding="8" Style="{DynamicResource Button.Busy}" />
                <Separator Margin="0,18,0,14" />
                <TextBlock Text="Apresentação" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" />
                <TextBlock Text="Use a tela selecionada para testar a saída que será compartilhada pelo cronômetro e pelo sorteio." Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" FontSize="11" Margin="0,10,0,8" />
                <Button Content="Testar tela de apresentação" Click="TestPresentation_Click" Padding="8" Style="{DynamicResource Button.Primary}" />
                <Button Content="Fechar tela de apresentação" Click="ClosePresentation_Click" Padding="8" Margin="0,7,0,0" Style="{DynamicResource Button.Busy}" />
                <Separator Margin="0,18,0,14" />
                <StackPanel Visibility="Collapsed">
                <TextBlock Text="Cronômetro" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" />
                <TextBlock Text="{Binding Timer.DisplayTime}" FontSize="34" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center" Margin="0,10,0,2" />
                <TextBlock Text="{Binding Timer.StateLabel}" Foreground="{DynamicResource Brush.TextSecondary}" HorizontalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="{Binding Timer.StartPauseLabel}" Click="TimerStartPause_Click" Padding="8" Margin="0,0,7,0" Style="{DynamicResource Button.Primary}" />
                    <Button Content="Parar/Zerar" Click="TimerReset_Click" Padding="8" />
                </StackPanel>
                <TextBlock Text="Direção" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,12,0,4" />
                <ComboBox ItemsSource="{Binding Timer.Directions}" SelectedItem="{Binding Timer.SelectedDirection}" SelectionChanged="TimerConfiguration_SelectionChanged" Padding="8">
                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="Duração regressiva (HH:MM:SS)" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,10,0,4" />
                <TextBox Text="{Binding Timer.CountdownDurationText, UpdateSourceTrigger=PropertyChanged}" LostFocus="TimerConfiguration_Changed" IsEnabled="{Binding Timer.IsCountdown}" Padding="8" />
                <TextBlock Text="Formato" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,10,0,4" />
                <ComboBox ItemsSource="{Binding Timer.DisplayFormats}" SelectedItem="{Binding Timer.SelectedFormat}" SelectionChanged="TimerConfiguration_SelectionChanged" Padding="8">
                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <Button Content="Abrir tela do cronômetro" Click="OpenTimerPresentation_Click" Padding="8" Margin="0,12,0,0" Style="{DynamicResource Button.Primary}" />
                <Button Content="Fechar tela do cronômetro" Click="CloseTimerPresentation_Click" Padding="8" Margin="0,7,0,0" Style="{DynamicResource Button.Busy}" />
                </StackPanel>
                <Separator Margin="0,18,0,14" />
                <TextBlock Text="Reprodução" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" />
                <TextBlock Text="Tela de saída do vídeo" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,14,0,4" />
                <ComboBox ItemsSource="{Binding PlaybackScreens}" SelectedItem="{Binding SelectedPlaybackScreen}" SelectionChanged="PlaybackScreen_SelectionChanged" Padding="8">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                    <TextBlock Text="Com uma tela selecionada, o video será reproduzido nela." Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0" />
                    <Separator Margin="0,18,0,14" />
                    <TextBlock Text="Vídeo selecionado" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" />
                    <TextBlock Text="{Binding SelectedItemTitle}" Foreground="{DynamicResource Brush.TextPrimary}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,0" />
                    <TextBlock Text="{Binding SelectedItemDetails}" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <Button Content="Excluir vídeo do computador" Click="DeleteSelectedVideo_Click" IsEnabled="{Binding HasSelectedItem}" Padding="8" Margin="0,10,0,0" Style="{DynamicResource Button.Busy}" />
                    <TextBlock Text="A exclusão remove o arquivo local; ele poderá ser baixado novamente depois." Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <ItemsControl ItemsSource="{Binding ScheduleItems}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource Brush.SurfaceRaised}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Title}" Foreground="{DynamicResource Brush.TextPrimary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding SourceName}" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="↑" Tag="{Binding}" Click="MoveScheduleUp_Click" Style="{DynamicResource Button.Icon}" /><Button Content="↓" Tag="{Binding}" Click="MoveScheduleDown_Click" Style="{DynamicResource Button.Icon}" /><Button Content="×" Tag="{Binding}" Click="RemoveSchedule_Click" Style="{DynamicResource Button.Icon}" /></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel></ScrollViewer>
        </Border>
    </Grid>
</Window>
