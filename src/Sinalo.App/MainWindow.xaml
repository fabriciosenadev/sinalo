<Window x:Class="Sinalo.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Sinalo" Height="720" Width="1280" MinHeight="580" MinWidth="940" Background="{DynamicResource Brush.Window}">
    <Window.Resources><BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" /></Window.Resources>
    <Grid Margin="18"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/><ColumnDefinition Width="290"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Grid.ColumnSpan="3" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Sinalo" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}"/><TextBlock Text="Conteúdos prontos para a programação da igreja" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,3,0,0"/></StackPanel><Button Grid.Column="1" Content="Atualizar Provai e Vede" Padding="14,8" Click="RefreshCatalog_Click" Style="{DynamicResource Button.Busy}"/><Button Grid.Column="3" Content="Sincronizar Provai e Vede" Padding="14,8" Click="SynchronizeProvaiEVede_Click" Style="{DynamicResource Button.Primary}"/><Button Grid.Column="5" Content="Configurar fontes" Padding="14,8" Click="ConfigureSources_Click" Style="{DynamicResource Button.Busy}"/></Grid></Border>
        <Border Grid.Row="1" Grid.ColumnSpan="3" Background="{DynamicResource Brush.Header}" BorderBrush="{DynamicResource Brush.HeaderBorder}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Sábado anterior" Foreground="{DynamicResource Brush.HeaderLabel}"/><TextBlock Text="{Binding PreviousSaturday}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Sábado atual" Foreground="{DynamicResource Brush.HeaderLabel}"/><TextBlock Text="{Binding CurrentSaturday}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Próximo sábado" Foreground="{DynamicResource Brush.HeaderLabel}"/><TextBlock Text="{Binding NextSaturday}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}"/></StackPanel><StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" Width="350"><TextBlock Text="{Binding OperationMessage}" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" HorizontalAlignment="Right"/><ProgressBar Height="8" Margin="0,7,0,0" Minimum="0" Maximum="100" Value="{Binding SyncProgressPercent}" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/></StackPanel></Grid></Border>
        <Border Grid.Row="2" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,14,0"><StackPanel><TextBlock Text="Biblioteca" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}"/><TextBlock Text="Fontes" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,18,0,6"/><Button Content="Todas as fontes" Tag="Todos" Click="SourceFilter_Click" Padding="8" Style="{DynamicResource Button.Navigation}"/><ItemsControl ItemsSource="{Binding Sources}"><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Name}" Tag="{Binding Name}" Click="SourceFilter_Click" Padding="8" ToolTip="{Binding Status}" Style="{DynamicResource Button.Navigation}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="Disponibilidade" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,18,0,6"/><Button Content="Todos" Tag="Todos" Click="AvailabilityFilter_Click" Padding="8" Style="{DynamicResource Button.Navigation}"/><Button Content="Pronto offline" Tag="Pronto offline" Click="AvailabilityFilter_Click" Padding="8" Style="{DynamicResource Button.Navigation}"/><Button Content="Disponível para sincronizar" Tag="Disponível para sincronizar" Click="AvailabilityFilter_Click" Padding="8" Style="{DynamicResource Button.Navigation}"/><Button Content="Somente online" Tag="Somente online" Click="AvailabilityFilter_Click" Padding="8" Style="{DynamicResource Button.Navigation}"/><TextBlock Text="{Binding ContentPath, StringFormat=Conteúdo local: {0}}" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" FontSize="11" Margin="0,20,0,0"/></StackPanel></Border>
        <Grid Grid.Row="2" Grid.Column="1" Margin="0,0,14,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,12"><TextBlock Text="Vídeos" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" DockPanel.Dock="Left"/><TextBox Width="250" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Padding="8" DockPanel.Dock="Right" ToolTip="Buscar por título"/></DockPanel><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding CatalogItems}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Tag="{Binding}" Click="CatalogItem_Click" Padding="0" Margin="0,0,12,12" Style="{DynamicResource Button.Card}"><Border Width="205" Background="{DynamicResource Brush.SurfaceRaised}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="10" Padding="12"><StackPanel><Border Height="96" Background="{DynamicResource Brush.Thumbnail}" CornerRadius="7"><TextBlock Text="{Binding ThumbnailGlyph}" FontSize="34" Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,10,0,0" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding SourceName}" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/><DockPanel Margin="0,8,0,0"><TextBlock Text="{Binding ScheduledDate}" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12"/><TextBlock Text="{Binding Status}" Foreground="{DynamicResource Brush.Warning}" FontSize="12" HorizontalAlignment="Right"/></DockPanel></StackPanel></Border></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Grid>
        <Border Grid.Row="2" Grid.Column="2" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="10" Padding="14"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Detalhes" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}"/><TextBlock Text="{Binding SelectedItemTitle}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" TextWrapping="Wrap" Margin="0,14,0,0"/><TextBlock Text="{Binding SelectedItemDetails}" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" Margin="0,6,0,0"/><TextBlock Text="{Binding SelectedItemPath}" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/><Button Content="Adicionar à programação" Click="AddToSchedule_Click" Margin="0,12,0,0" Padding="10" Style="{DynamicResource Button.Primary}"/><Separator Margin="0,18,0,14"/><TextBlock Text="Programação do sábado" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}"/><TextBlock Text="Organize os vídeos que serão usados." Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12" Margin="0,4,0,10"/><ItemsControl ItemsSource="{Binding ScheduleItems}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource Brush.SurfaceRaised}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Title}" Foreground="{DynamicResource Brush.TextPrimary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding SourceName}" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="↑" Tag="{Binding}" Click="MoveScheduleUp_Click" Style="{DynamicResource Button.Icon}"/><Button Content="↓" Tag="{Binding}" Click="MoveScheduleDown_Click" Style="{DynamicResource Button.Icon}"/><Button Content="×" Tag="{Binding}" Click="RemoveSchedule_Click" Style="{DynamicResource Button.Icon}"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer></Border>
    </Grid>
</Window>
