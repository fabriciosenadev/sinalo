<Window
  Style="{DynamicResource {x:Type Window}}"
  x:Class="Sinalo.App.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:views="clr-namespace:Sinalo.App.Views"
  xmlns:local="clr-namespace:Sinalo.App"
  Title="Sinalo"
  Height="720"
  Width="1280"
  MinHeight="580"
  MinWidth="940"
  Background="{DynamicResource Brush.Window}">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary
          Source="VisualIdentity.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter
        x:Key="BooleanToVisibilityConverter" />
    </ResourceDictionary>
  </Window.Resources>
  <Grid
    Margin="16"
    Background="{DynamicResource Brush.Window}"
    TextElement.Foreground="{DynamicResource Brush.TextPrimary}">
    <Grid.RowDefinitions>
      <RowDefinition
        Height="Auto" />
      <RowDefinition
        Height="Auto" />
      <RowDefinition
        Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition
        Width="220" />
      <ColumnDefinition
        Width="*" />
    </Grid.ColumnDefinitions>
    <Border
      Grid.ColumnSpan="2"
      Style="{DynamicResource Surface.Section}"
      Padding="14,10">
      <DockPanel>
        <WrapPanel
          DockPanel.Dock="Right"
          HorizontalAlignment="Right">
          <Button
            Content="{Binding DownloadsLabel}"
            Click="OpenDownloads_Click"
            ToolTip="Acompanhar os downloads desta sessão"
            Margin="0,0,8,8"
            VerticalAlignment="Center" />
          <Button
            Content="Atualização"
            Click="OpenUpdate_Click"
            Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BooleanToVisibilityConverter}}"
            Margin="0,0,8,8"
            VerticalAlignment="Center" />
          <Button
            Content="Configurações"
            Click="ConfigureSources_Click"
            Margin="0,0,8,8"
            VerticalAlignment="Center" />
        </WrapPanel>
        <WrapPanel
          VerticalAlignment="Center">
          <TextBlock
            Text="Sinalo"
            FontSize="24"
            FontWeight="SemiBold"
            Margin="0,0,12,0" />
          <TextBlock
            Text="{Binding ApplicationVersion}"
            Foreground="{DynamicResource Brush.TextSecondary}"
            VerticalAlignment="Center"
            Margin="0,0,12,0" />
          <Button
            Content="Novidades"
            Click="OpenReleaseNotes_Click"
            Style="{DynamicResource Button.Navigation}"
            Margin="0,0,8,8"
            VerticalAlignment="Center" />
        </WrapPanel>
      </DockPanel>
    </Border>
    <WrapPanel
      Grid.Row="1"
      Grid.ColumnSpan="2"
      Margin="0,0,0,8">
      <Border
        Background="{DynamicResource Brush.SurfaceRaised}"
        CornerRadius="6"
        Padding="8"
        Margin="0,0,8,8"
        Visibility="{Binding IsQueueActive, Converter={StaticResource BooleanToVisibilityConverter}}">
        <TextBlock
          Text="Downloads em andamento · acompanhe em Downloads" />
      </Border>
      <WrapPanel
        Visibility="{Binding WorshipTimer.CanControlAudio, Converter={StaticResource BooleanToVisibilityConverter}}">
        <TextBlock
          Text="{Binding WorshipTimer.AudioOriginLabel}"
          VerticalAlignment="Center"
          Margin="0,0,12,8" />
        <Button
          Content="Parar áudio"
          Click="StopWorshipTimerAudio_Click"
          Margin="0,0,8,8"
          VerticalAlignment="Center" />
        <Button
          Content="Ver áudio do culto"
          Click="WorshipTimerWorkspace_Click"
          Margin="0,0,8,8"
          VerticalAlignment="Center" />
      </WrapPanel>
      <WrapPanel
        Visibility="{Binding IsPresentationOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
        <TextBlock
          Text="Apresentação aberta"
          VerticalAlignment="Center"
          Margin="0,0,12,8" />
        <Button
          Content="Fechar apresentação"
          Click="ClosePresentation_Click"
          Margin="0,0,8,8"
          VerticalAlignment="Center" />
      </WrapPanel>
    </WrapPanel>
    <Border
      Grid.Row="2"
      Background="{DynamicResource Brush.Surface}"
      BorderBrush="{DynamicResource Brush.Border}"
      BorderThickness="1"
      CornerRadius="8"
      Padding="12"
      Margin="0,0,16,0">
      <ScrollViewer
        x:Name="NavigationScrollViewer"
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled"
        Padding="0,0,12,0">
        <StackPanel>
          <TextBlock
            Text="Navegação"
            FontSize="18"
            FontWeight="SemiBold"
            Margin="0,0,0,20" />
          <Button Content="Biblioteca" Click="GeneralLibrary_Click" Margin="0,0,0,16">
            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource Button.Navigation}"><Style.Triggers>
              <DataTrigger Binding="{Binding IsGeneralLibraryWorkspace}" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.Selection}" /><Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" /></DataTrigger>
            </Style.Triggers></Style></Button.Style>
          </Button>
          <TextBlock
            Text="PROGRAMAS DE VÍDEO"
            FontSize="12"
            Foreground="{DynamicResource Brush.TextSecondary}"
            Margin="0,0,0,8" />
          <ItemsControl
            ItemsSource="{Binding Sources}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button
                  Content="{Binding Name}"
                  Tag="{Binding Name}"
                  Click="SourceFilter_Click">
                  <Button.Style>
                    <Style
                      TargetType="Button"
                      BasedOn="{StaticResource Button.Navigation}">
                      <Style.Triggers>
                        <DataTrigger
                          Binding="{Binding IsSelected}"
                          Value="True">
                          <Setter
                            Property="Background"
                            Value="{DynamicResource Brush.Selection}" />
                          <Setter
                            Property="BorderBrush"
                            Value="{DynamicResource Brush.Accent}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button x:Name="ScheduleNavigationButton"
            Content="Programação desta sessão"
            Style="{DynamicResource Button.Navigation}"
            Click="OpenSchedule_Click"
            ToolTip="Ver e organizar os vídeos adicionados à programação; não inicia reprodução automática"
            Margin="0,16,0,8" />
          <TextBlock Text="MINHAS CATEGORIAS" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,16,0,8"/>
          <ItemsControl x:Name="CustomCategoryNavigation" ItemsSource="{Binding CustomCategories, RelativeSource={RelativeSource AncestorType=Window}}">
            <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding}" Tag="{Binding}" ToolTip="{Binding Name}" Click="Category_Click" Style="{DynamicResource Button.Navigation}"/></DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button x:Name="ManageCategoriesButton" Content="Criar / gerenciar categorias" Click="ManageCategories_Click" Style="{DynamicResource Button.Navigation}" Margin="0,8,0,8"/>
          <TextBlock
            Text="ADICIONAR VÍDEO"
            FontSize="12"
            Foreground="{DynamicResource Brush.TextSecondary}"
            Margin="0,24,0,8" />
          <Button
            x:Name="LinkedVideoNavigationButton"
            Content="Vídeo por link"
            Click="LinkedVideoWorkspace_Click">
            <Button.Style>
              <Style
                TargetType="Button"
                BasedOn="{StaticResource Button.Navigation}">
                <Style.Triggers>
                  <DataTrigger
                    Binding="{Binding IsLinkedVideoWorkspace}"
                    Value="True">
                    <Setter
                      Property="Background"
                      Value="{DynamicResource Brush.Selection}" />
                    <Setter
                      Property="BorderBrush"
                      Value="{DynamicResource Brush.Accent}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
          <TextBlock
            Text="FERRAMENTAS DE APRESENTAÇÃO"
            FontSize="12"
            Foreground="{DynamicResource Brush.TextSecondary}"
            Margin="0,24,0,8" />
          <Button
            Content="Cronômetro"
            Click="TimerWorkspace_Click">
            <Button.Style>
              <Style
                TargetType="Button"
                BasedOn="{StaticResource Button.Navigation}">
                <Style.Triggers>
                  <DataTrigger
                    Binding="{Binding IsTimerWorkspace}"
                    Value="True">
                    <Setter
                      Property="Background"
                      Value="{DynamicResource Brush.Selection}" />
                    <Setter
                      Property="BorderBrush"
                      Value="{DynamicResource Brush.Accent}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
          <Button
            Content="Cronômetro de Culto"
            Click="WorshipTimerWorkspace_Click">
            <Button.Style>
              <Style
                TargetType="Button"
                BasedOn="{StaticResource Button.Navigation}">
                <Style.Triggers>
                  <DataTrigger
                    Binding="{Binding IsWorshipTimerWorkspace}"
                    Value="True">
                    <Setter
                      Property="Background"
                      Value="{DynamicResource Brush.Selection}" />
                    <Setter
                      Property="BorderBrush"
                      Value="{DynamicResource Brush.Accent}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
          <Button
            Content="Sorteio"
            Click="RaffleWorkspace_Click">
            <Button.Style>
              <Style
                TargetType="Button"
                BasedOn="{StaticResource Button.Navigation}">
                <Style.Triggers>
                  <DataTrigger
                    Binding="{Binding IsRaffleWorkspace}"
                    Value="True">
                    <Setter
                      Property="Background"
                      Value="{DynamicResource Brush.Selection}" />
                    <Setter
                      Property="BorderBrush"
                      Value="{DynamicResource Brush.Accent}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
        </StackPanel>
      </ScrollViewer>
    </Border>
    <Grid
      Grid.Row="2"
      Grid.Column="1"
      x:Name="WorkspaceRegion">
      <Grid.RowDefinitions>
        <RowDefinition
          Height="Auto" />
        <RowDefinition
          Height="*" />
        <RowDefinition
          Height="Auto" />
      </Grid.RowDefinitions>
      <WrapPanel
        Margin="0,0,0,12">
        <TextBlock
          Text="{Binding WorkspaceTitle}"
          Style="{DynamicResource Text.Heading}"
          Margin="0,0,20,8" />
        <WrapPanel>
          <WrapPanel.Style>
            <Style
              TargetType="WrapPanel">
              <Style.Triggers>
                <DataTrigger
                  Binding="{Binding IsCompactWorkspace}"
                  Value="True">
                  <Setter
                    Property="Visibility"
                    Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </WrapPanel.Style>
          <StackPanel>
            <TextBlock
              Text="Tela de saída"
              FontSize="12"
              Foreground="{DynamicResource Brush.TextSecondary}" />
            <ComboBox
              Width="230"
              ItemsSource="{Binding PlaybackScreens}"
              SelectedItem="{Binding SelectedPlaybackScreen}"
              SelectionChanged="PlaybackScreen_SelectionChanged"
              AutomationProperties.Name="Tela de saída">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock
                    Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <Button
            Content="Conferir tela"
            Click="TestPresentation_Click"
            VerticalAlignment="Bottom"
            Margin="8,0,8,0"
            ToolTip="Exibe identificação da tela selecionada" />
        </WrapPanel>
        <Expander
          Header="Tela de saída"
          Visibility="{Binding IsCompactWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}">
          <WrapPanel>
            <ComboBox
              Width="230"
              ItemsSource="{Binding PlaybackScreens}"
              SelectedItem="{Binding SelectedPlaybackScreen}"
              SelectionChanged="PlaybackScreen_SelectionChanged"
              AutomationProperties.Name="Tela de saída">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock
                    Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button
              Content="Conferir tela"
              Click="TestPresentation_Click"
              Margin="0,0,8,8"
              VerticalAlignment="Center" />
          </WrapPanel>
        </Expander>
      </WrapPanel>
      <Grid
        Grid.Row="1"
        x:Name="ProgramWorkspace"
        Visibility="{Binding IsLibraryWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Grid.RowDefinitions>
          <RowDefinition
            Height="Auto" />
          <RowDefinition
            Height="Auto" />
          <RowDefinition
            Height="Auto" />
          <RowDefinition
            Height="*" />
          <RowDefinition
            Height="Auto" />
        </Grid.RowDefinitions>
        <Border
          x:Name="SaturdayHeader"
          Visibility="{Binding ShowProgramCalendar, Converter={StaticResource BooleanToVisibilityConverter}}"
          Background="{DynamicResource Brush.Header}"
          CornerRadius="8"
          Padding="12"
          Margin="0,0,0,12">
          <WrapPanel>
            <StackPanel
              Margin="0,0,24,0">
              <TextBlock
                Text="Sábado anterior"
                Foreground="{DynamicResource Brush.HeaderLabel}"
                FontSize="12" />
              <TextBlock
                Text="{Binding PreviousSaturday}"
                Foreground="{DynamicResource Brush.HeaderText}" />
            </StackPanel>
            <StackPanel
              Margin="0,0,24,0">
              <TextBlock
                Text="Sábado atual"
                Foreground="{DynamicResource Brush.HeaderLabel}"
                FontSize="12" />
              <TextBlock
                Text="{Binding CurrentSaturday}"
                Foreground="{DynamicResource Brush.HeaderText}"
                FontWeight="SemiBold" />
            </StackPanel>
            <StackPanel>
              <TextBlock
                Text="Próximo sábado"
                Foreground="{DynamicResource Brush.HeaderLabel}"
                FontSize="12" />
              <TextBlock
                Text="{Binding NextSaturday}"
                Foreground="{DynamicResource Brush.HeaderText}" />
            </StackPanel>
          </WrapPanel>
        </Border>
        <WrapPanel
          Grid.Row="1">
          <Button
            Content="Buscar e baixar"
            Click="UpdateAndSynchronizeSelectedSource_Click"
            IsEnabled="{Binding CanQueueSelectedSource}"
            Style="{DynamicResource Button.Primary}"
            Margin="0,0,8,8"
            VerticalAlignment="Center" />
          <Button
            Content="Mais opções ▾"
            Click="ProgramOptions_Click"
            Margin="0,0,8,8"
            VerticalAlignment="Center">
            <Button.ContextMenu>
              <ContextMenu>
                <MenuItem
                  Header="Escolher vídeos para baixar"
                  Click="DiscoverSelectedSource_Click" />
                <MenuItem
                  Header="Adicionar vídeo por link"
                  Click="AddLinkForProgram_Click" />
                <MenuItem
                  Header="Alterar regra de busca"
                  Tag="ProgramSearchRules"
                  Click="ConfigureSources_Click" />
                <Separator />
                <MenuItem
                  Header="Programação desta sessão"
                  Click="OpenSchedule_Click" />
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
        </WrapPanel>
        <StackPanel
          Grid.Row="2"
          Margin="0,0,0,12">
          <Expander
            Header="Regra de busca e disponibilidade"
            Margin="0,0,0,8">
            <Expander.Style><Style TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}"><Style.Triggers>
              <DataTrigger Binding="{Binding IsCompactWorkspace}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
            </Style.Triggers></Style></Expander.Style>
            <StackPanel>
              <TextBlock
                Text="{Binding SelectedSourcePolicy, StringFormat=Busca configurada: {0}}"
                Foreground="{DynamicResource Brush.TextSecondary}"
                FontSize="13" />
              <TextBlock
                Text="A busca só baixa vídeos encontrados e disponíveis. A regra não garante publicação."
                Foreground="{DynamicResource Brush.TextSecondary}"
                FontSize="13"
                Margin="0,4,0,8" />
            </StackPanel>
          </Expander>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition
                Width="*" />
              <ColumnDefinition
                Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock
                Text="Pesquisar por título ou data"
                FontSize="13" />
              <TextBox
                Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                AutomationProperties.Name="Pesquisar por título ou data"
                ToolTip="Exemplo: Enoc ou 15/08/2026" />
            </StackPanel>
            <Button
              Grid.Column="1"
              Content="Limpar"
              Click="ClearSearch_Click"
              VerticalAlignment="Bottom"
              Margin="8,0,0,0"
              ToolTip="Limpar pesquisa" />
          </Grid>
          <TextBlock
            Text="{Binding CatalogSummary}"
            FontSize="13"
            Foreground="{DynamicResource Brush.TextSecondary}"
            Margin="0,8,0,0">
            <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
              <DataTrigger Binding="{Binding IsCompactWorkspace}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
            </Style.Triggers></Style></TextBlock.Style>
          </TextBlock>
        </StackPanel>
        <Grid
          Grid.Row="3"
          x:Name="CatalogRegion">
          <Grid.ColumnDefinitions>
            <ColumnDefinition
              Width="*" />
            <ColumnDefinition
              x:Name="DetailsColumn"
              Width="0" />
          </Grid.ColumnDefinitions>
          <Grid
            x:Name="CatalogListRegion">
            <ListBox
              x:Name="CatalogList"
              ItemsSource="{Binding CatalogItems}"
              SelectedItem="{Binding SelectedCatalogItem}"
              MouseDoubleClick="CatalogItem_DoubleClick"
              VirtualizingPanel.IsVirtualizing="True"
              VirtualizingPanel.VirtualizationMode="Recycling"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
              Background="{DynamicResource Brush.Surface}"
              BorderBrush="{DynamicResource Brush.Border}"
              Padding="0,0,12,0"
              HorizontalContentAlignment="Stretch">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border
                    Padding="12"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="0,0,0,1">
                    <StackPanel>
                      <TextBlock
                        Text="{Binding Title}"
                        FontSize="16"
                        FontWeight="SemiBold" />
                      <WrapPanel
                        Margin="0,6,0,0">
                        <TextBlock
                          Text="{Binding ScheduledDate}"
                          Margin="0,0,16,0" />
                        <TextBlock
                          Text="{Binding SourceName}"
                          Foreground="{DynamicResource Brush.TextSecondary}"
                          Margin="0,0,16,0" />
                        <TextBlock
                          Text="Pronto para reproduzir"
                          Foreground="{DynamicResource Brush.Success}" />
                        <TextBlock
                          Text=" · Fixado"
                          Visibility="{Binding IsPinned, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock
                          Text="{Binding PlaybackLabel}"
                          Margin="16,0,0,0" />
                      </WrapPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Border
              Background="{DynamicResource Brush.Surface}"
              Padding="24"
              Visibility="{Binding IsCatalogEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
              <StackPanel
                VerticalAlignment="Center">
                <TextBlock
                  Text="{Binding CatalogEmptyMessage}"
                  FontSize="18" />
                <Button
                  Content="Limpar pesquisa"
                  Click="ClearSearch_Click"
                  HorizontalAlignment="Left"
                  Margin="0,16,0,0" />
              </StackPanel>
            </Border>
          </Grid>
          <Border
            x:Name="CatalogDetails"
            Grid.Column="1"
            Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16"
            Margin="16,0,0,0"
            Visibility="{Binding ShowCatalogDetails, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition
                  Height="Auto" />
                <RowDefinition
                  Height="*" />
                <RowDefinition
                  Height="Auto" />
              </Grid.RowDefinitions>
              <Button
                Content="Voltar aos vídeos"
                Click="CloseDetails_Click"
                HorizontalAlignment="Left" />
              <ScrollViewer
                Grid.Row="1"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                Padding="0,0,12,0">
                <StackPanel>
                  <TextBlock
                    Text="{Binding SelectedItemTitle}"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Margin="0,0,0,12" />
                  <TextBlock
                    Text="{Binding SelectedItemDetails}"
                    Margin="0,0,0,12" />
                  <Button
                    Content="Adicionar à programação"
                    Click="AddToSchedule_Click" />
                  <Button
                    Content="{Binding SelectedItemPinActionLabel}"
                    Click="ToggleSelectedVideoPin_Click" />
                  <Expander
                    Header="Local do arquivo"
                    Margin="0,12">
                    <TextBox
                      Text="{Binding SelectedItemPath, Mode=OneWay}"
                      IsReadOnly="True"
                      TextWrapping="Wrap" />
                  </Expander>
                  <TextBlock
                    Text="Excluir remove o arquivo deste computador. O vídeo pode ser baixado novamente."
                    FontSize="13"
                    Foreground="{DynamicResource Brush.TextSecondary}"
                    Margin="0,16,0,8" />
                  <Button
                    Content="Excluir vídeo do computador"
                    Click="DeleteSelectedVideo_Click"
                    Style="{DynamicResource Button.Danger}" />
                </StackPanel>
              </ScrollViewer>
              <Button
                Grid.Row="2"
                Content="{Binding SelectedPlaybackLabel}"
                Click="PlaySelected_Click"
                IsEnabled="{Binding HasSelectedItem}"
                Style="{DynamicResource Button.Primary}"
                Margin="0,12,0,0" />
            </Grid>
          </Border>
        </Grid>
      </Grid>
      <ScrollViewer
        x:Name="LinkedVideoWorkspace"
        Grid.Row="1"
        VerticalScrollBarVisibility="Disabled"
        HorizontalScrollBarVisibility="Disabled"
        Visibility="{Binding IsLinkedVideoWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}">
        <views:LinkedVideoView />
      </ScrollViewer>
      <views:TimerView
        Grid.Row="1"
        Visibility="{Binding IsTimerWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}" />
      <local:LibraryView x:Name="GeneralLibraryWorkspace" Grid.Row="1"
                   DataContext="{Binding Library, RelativeSource={RelativeSource AncestorType=Window}}"
                   Visibility="{Binding DataContext.IsGeneralLibraryWorkspace, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" />
      <views:RaffleView
        Grid.Row="1"
        Visibility="{Binding IsRaffleWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}" />
      <views:WorshipTimerView
        Grid.Row="1"
        Visibility="{Binding IsWorshipTimerWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}" />
      <TextBlock
        Grid.Row="2"
        Text="{Binding OperationMessage}"
        Foreground="{DynamicResource Brush.TextSecondary}"
        ToolTip="{Binding OperationMessage}"
        Margin="0,12,0,0">
        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Style.Triggers>
          <DataTrigger Binding="{Binding IsGeneralLibraryWorkspace}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
          <DataTrigger Binding="{Binding IsCompactWorkspace}" Value="True">
            <Setter Property="TextWrapping" Value="NoWrap" /><Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="FontSize" Value="12" /><Setter Property="Margin" Value="0,8,0,0" />
          </DataTrigger>
        </Style.Triggers></Style></TextBlock.Style>
      </TextBlock>
    </Grid>
    <Border Grid.Row="3" Grid.ColumnSpan="2" Margin="0,8,0,0" Padding="8"
            Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1" CornerRadius="8">
      <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers><DataTrigger Binding="{Binding Playback.HasSession, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger></Style.Triggers>
      </Style></Border.Style>
      <StackPanel x:Name="PlaybackPanel" DataContext="{Binding Playback, RelativeSource={RelativeSource AncestorType=Window}}">
        <Expander x:Name="PlaybackDetails" IsExpanded="True" ToolTip="Expandir para ajustar posição, volume e reiniciar o vídeo">
          <Expander.Header>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                <TextBlock Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12"><Run Text="{Binding Status, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding TimeLabel, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding PlayerAndOutput, Mode=OneWay}" /></TextBlock>
              </StackPanel>
              <WrapPanel Grid.Column="1">
                <Button Content="{Binding PlayPauseLabel}" Command="{Binding PlayPauseCommand}" Style="{DynamicResource Button.Primary}" Margin="0,0,8,0" />
                <Button Content="Parar" Command="{Binding StopCommand}" Margin="0" />
              </WrapPanel>
            </Grid>
          </Expander.Header>
          <StackPanel Margin="0,8,0,0">
            <Slider x:Name="VideoSeekSlider" Minimum="0" Maximum="{Binding DurationSeconds}" Value="{Binding PositionSeconds}"
                    IsEnabled="{Binding CanSeek}" PreviewMouseLeftButtonDown="VideoSeek_Begin" PreviewMouseLeftButtonUp="VideoSeek_Commit"
                    PreviewKeyDown="VideoSeek_KeyDown" PreviewKeyUp="VideoSeek_KeyUp" AutomationProperties.Name="Posição do vídeo" Margin="0,4,0,4" />
            <WrapPanel>
              <Button Content="Reiniciar vídeo" Command="{Binding RestartCommand}" />
              <StackPanel Orientation="Horizontal" Margin="0,0,12,8" Height="40">
                <TextBlock Text="Volume" VerticalAlignment="Center" Margin="0,0,8,0" />
                <Slider x:Name="VideoVolumeSlider" Width="130" Minimum="0" Maximum="100" Value="{Binding Volume}" IsEnabled="{Binding CanVolume}"
                        PreviewMouseLeftButtonDown="VideoVolume_Begin" PreviewMouseLeftButtonUp="VideoVolume_Commit"
                        PreviewKeyDown="VideoVolume_KeyDown" PreviewKeyUp="VideoVolume_KeyUp" AutomationProperties.Name="Volume do vídeo" />
              </StackPanel>
              <Button Content="{Binding MuteLabel}" Command="{Binding ToggleMuteCommand}" />
            </WrapPanel>
          </StackPanel>
        </Expander>
        <TextBlock Text="{Binding Message}" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12">
          <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
            <DataTrigger Binding="{Binding Message}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
          </Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
      </StackPanel>
    </Border>
  </Grid>
</Window>
