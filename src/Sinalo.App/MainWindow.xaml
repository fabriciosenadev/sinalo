<Window x:Class="Sinalo.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sinalo" Height="720" Width="1280" MinHeight="580" MinWidth="940" Background="#0F172A">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <SolidColorBrush x:Key="Brush.Surface" Color="#172033" />
        <SolidColorBrush x:Key="Brush.SurfaceRaised" Color="#1F2937" />
        <SolidColorBrush x:Key="Brush.Border" Color="#334155" />
        <SolidColorBrush x:Key="Brush.TextPrimary" Color="#F8FAFC" />
        <SolidColorBrush x:Key="Brush.TextSecondary" Color="#CBD5E1" />
        <SolidColorBrush x:Key="Brush.Accent" Color="#2DD4BF" />
        <SolidColorBrush x:Key="Brush.Warning" Color="#FBBF24" />
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="Background" Value="#25344A" />
            <Setter Property="BorderBrush" Value="#475569" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#2D4660"/><Setter TargetName="Surface" Property="BorderBrush" Value="#2DD4BF"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#162438"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="TextBox"><Setter Property="Foreground" Value="#F8FAFC"/><Setter Property="Background" Value="#0F172A"/><Setter Property="BorderBrush" Value="#475569"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CaretBrush" Value="#2DD4BF"/></Style>
        <Style TargetType="ProgressBar"><Setter Property="Foreground" Value="#2DD4BF"/><Setter Property="Background" Value="#334155"/></Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="290" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.ColumnSpan="3" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Sinalo" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextPrimary}"/><TextBlock Text="Conteúdos prontos para a programação da igreja" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,3,0,0"/></StackPanel>
                <Button Grid.Column="1" Content="Atualizar Provai e Vede" Padding="14,8" Click="RefreshCatalog_Click">
                    <Button.Style><Style TargetType="Button"><Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Button.Style>
                </Button>
                <Button Grid.Column="3" Content="Sincronizar Provai e Vede" Padding="14,8" Click="SynchronizeProvaiEVede_Click">
                    <Button.Style><Style TargetType="Button"><Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Button.Style>
                </Button>
                <Button Grid.Column="5" Content="Configurar fontes" Padding="14,8" Click="ConfigureSources_Click" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.ColumnSpan="3" Background="#111C2D" BorderBrush="#2A405A" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Sábado anterior" Foreground="#94A3B8"/><TextBlock Text="{Binding PreviousSaturday}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextPrimary}"/></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock Text="Sábado atual" Foreground="#94A3B8"/><TextBlock Text="{Binding CurrentSaturday}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Brush.Accent}"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="Próximo sábado" Foreground="#94A3B8"/><TextBlock Text="{Binding NextSaturday}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextPrimary}"/></StackPanel>
                <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" Width="350"><TextBlock Text="{Binding OperationMessage}" Foreground="{StaticResource Brush.TextSecondary}" TextWrapping="Wrap" HorizontalAlignment="Right"/><ProgressBar Height="8" Margin="0,7,0,0" Minimum="0" Maximum="100" Value="{Binding SyncProgressPercent}" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/></StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,14,0">
            <StackPanel>
                <TextBlock Text="Biblioteca" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextPrimary}"/>
                <TextBlock Text="Fontes" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,18,0,6"/>
                <Button Content="Todas as fontes" Tag="Todos" Click="SourceFilter_Click" HorizontalContentAlignment="Left" Padding="8"/>
                <ItemsControl ItemsSource="{Binding Sources}"><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Name}" Tag="{Binding Name}" Click="SourceFilter_Click" HorizontalContentAlignment="Left" Padding="8" ToolTip="{Binding Status}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <TextBlock Text="Disponibilidade" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,18,0,6"/>
                <Button Content="Todos" Tag="Todos" Click="AvailabilityFilter_Click" HorizontalContentAlignment="Left" Padding="8"/>
                <Button Content="Pronto offline" Tag="Pronto offline" Click="AvailabilityFilter_Click" HorizontalContentAlignment="Left" Padding="8"/>
                <Button Content="Disponível para sincronizar" Tag="Disponível para sincronizar" Click="AvailabilityFilter_Click" HorizontalContentAlignment="Left" Padding="8"/>
                <Button Content="Somente online" Tag="Somente online" Click="AvailabilityFilter_Click" HorizontalContentAlignment="Left" Padding="8"/>
                <TextBlock Text="{Binding ContentPath, StringFormat=Conteúdo local: {0}}" Foreground="{StaticResource Brush.TextSecondary}" TextWrapping="Wrap" FontSize="11" Margin="0,20,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Grid.Column="1" Margin="0,0,14,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,12"><TextBlock Text="Vídeos" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextPrimary}" DockPanel.Dock="Left"/><TextBox Width="250" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Padding="8" DockPanel.Dock="Right" ToolTip="Buscar por título"/></DockPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding CatalogItems}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
                <Button Tag="{Binding}" Click="CatalogItem_Click" Padding="0" Margin="0,0,12,12" BorderThickness="0" Background="Transparent"><Border Width="205" Background="{StaticResource Brush.SurfaceRaised}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="10" Padding="12"><StackPanel>
                    <Border Height="96" Background="#0F172A" CornerRadius="7"><TextBlock Text="{Binding ThumbnailGlyph}" FontSize="34" Foreground="{StaticResource Brush.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextPrimary}" Margin="0,10,0,0" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding SourceName}" Foreground="{StaticResource Brush.TextSecondary}" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                    <DockPanel Margin="0,8,0,0"><TextBlock Text="{Binding ScheduledDate}" Foreground="{StaticResource Brush.TextSecondary}" FontSize="12"/><TextBlock Text="{Binding Status}" Foreground="{StaticResource Brush.Warning}" FontSize="12" HorizontalAlignment="Right"/></DockPanel>
                </StackPanel></Border></Button>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Grid.Column="2" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="10" Padding="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                <TextBlock Text="Detalhes" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextPrimary}"/>
                <TextBlock Text="{Binding SelectedItemTitle}" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextPrimary}" TextWrapping="Wrap" Margin="0,14,0,0"/>
                <TextBlock Text="{Binding SelectedItemDetails}" Foreground="{StaticResource Brush.TextSecondary}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                <TextBlock Text="{Binding SelectedItemPath}" Foreground="{StaticResource Brush.TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                <Button Content="Adicionar à programação" Click="AddToSchedule_Click" Margin="0,12,0,0" Padding="10"/>
                <Separator Margin="0,18,0,14"/>
                <TextBlock Text="Programação do sábado" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextPrimary}"/>
                <TextBlock Text="Organize os vídeos que serão usados." Foreground="{StaticResource Brush.TextSecondary}" FontSize="12" Margin="0,4,0,10"/>
                <ItemsControl ItemsSource="{Binding ScheduleItems}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource Brush.SurfaceRaised}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Title}" Foreground="{StaticResource Brush.TextPrimary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding SourceName}" Foreground="{StaticResource Brush.TextSecondary}" FontSize="11"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="↑" Tag="{Binding}" Click="MoveScheduleUp_Click"/><Button Content="↓" Tag="{Binding}" Click="MoveScheduleDown_Click"/><Button Content="×" Tag="{Binding}" Click="RemoveSchedule_Click"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel></ScrollViewer>
        </Border>
    </Grid>
</Window>
