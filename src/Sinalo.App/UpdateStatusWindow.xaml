<Window
  Style="{DynamicResource {x:Type Window}}"
  x:Class="Sinalo.App.UpdateStatusWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Atualização do Sinalo"
  Width="560"
  Height="380"
  WindowStartupLocation="CenterOwner"
  Background="{DynamicResource Brush.Window}">
  <Grid
    Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition
        Height="Auto" />
      <RowDefinition
        Height="*" />
      <RowDefinition
        Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock
      Text="Atualização do Sinalo"
      Style="{DynamicResource Text.Heading}" />
    <StackPanel
      Grid.Row="1">
      <TextBlock
        Text="{Binding ApplicationVersion}" />
      <TextBlock
        Text="{Binding UpdateMessage}"
        Margin="0,16" />
      <ProgressBar
        Height="8"
        Maximum="100"
        Value="{Binding UpdateProgressPercent}"
        IsIndeterminate="{Binding IsInstallingUpdate}" />
      <TextBlock
        Text="Instale em um momento seguro. Vídeo, áudio, apresentação e downloads serão encerrados."
        Margin="0,16" />
    </StackPanel>
    <WrapPanel
      Grid.Row="2"
      HorizontalAlignment="Right">
      <Button
        Content="Fechar"
        IsCancel="True"
        Margin="0,0,8,8"
        VerticalAlignment="Center">
        <Button.Style>
          <Style
            TargetType="Button"
            BasedOn="{StaticResource {x:Type Button}}">
            <Style.Triggers>
              <DataTrigger
                Binding="{Binding IsInstallingUpdate}"
                Value="True">
                <Setter
                  Property="IsEnabled"
                  Value="False" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Button.Style>
      </Button>
      <Button
        Content="Atualizar e reiniciar"
        IsEnabled="{Binding IsUpdateReady}"
        Click="Install_Click"
        Style="{DynamicResource Button.Primary}"
        Margin="0,0,8,8"
        VerticalAlignment="Center" />
    </WrapPanel>
  </Grid>
</Window>