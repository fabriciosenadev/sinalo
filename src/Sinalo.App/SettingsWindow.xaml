<Window x:Class="Sinalo.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurações"
        Width="660"
        Height="800"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Window}">
    <Border Margin="18" Padding="24" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="Configurações" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" />
                <TextBlock Text="Informe o site oficial e a regra de download de cada programa." Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,4,0,16" />
                <Border Background="{DynamicResource Brush.ButtonHover}" BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Importante" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" />
                        <TextBlock Text="A configuração define quais vídeos serão procurados. O download só acontece quando o programa disponibilizar um vídeo publicado com arquivo oficial disponível." Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,3,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource Brush.SurfaceRaised}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Tema do aplicativo" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" />
                        <TextBlock Text="Escolha uma aparência fixa ou acompanhe a preferência do Windows." Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,3,0,8" TextWrapping="Wrap" />
                        <ComboBox x:Name="ThemePreferenceCombo" SelectedIndex="0" Padding="8">
                            <ComboBoxItem Content="Mesmo tema do Windows" />
                            <ComboBoxItem Content="Tema claro" />
                            <ComboBoxItem Content="Tema escuro" />
                        </ComboBox>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource Brush.SurfaceRaised}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Conteúdo local" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" />
                        <TextBlock Text="Ao salvar, os vídeos existentes serão transferidos para a pasta escolhida." Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,3,0,8" TextWrapping="Wrap" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox x:Name="ContentPathText" IsReadOnly="True" Padding="8" Margin="0,0,8,0" />
                            <Button Grid.Column="1" Content="Escolher pasta" Click="ChooseContentPath_Click" Padding="12,8" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,16">
                <StackPanel>
                    <Border Background="{DynamicResource Brush.SurfaceRaised}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Informativo das Missões" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" />
                            <TextBlock Text="Site oficial do programa" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12" Margin="0,3,0,6" />
                            <TextBox x:Name="MissionsUrl" Padding="8" />
                            <Separator Margin="0,14,0,12" Background="{DynamicResource Brush.Border}" />
                            <TextBlock Text="Vídeos a baixar" Foreground="{DynamicResource Brush.TextPrimary}" FontWeight="SemiBold" />
                            <TextBlock Text="Marque os sábados desejados. Sem seleção, o trimestre inteiro será baixado." Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12" Margin="0,3,0,6" TextWrapping="Wrap" />
                            <CheckBox x:Name="MissionsPreviousSaturday" Content="Sábado anterior" Checked="SaturdaySelection_Changed" Unchecked="SaturdaySelection_Changed" />
                            <CheckBox x:Name="MissionsCurrentSaturday" Content="Sábado atual" Checked="SaturdaySelection_Changed" Unchecked="SaturdaySelection_Changed" />
                            <CheckBox x:Name="MissionsNextSaturday" Content="Próximo sábado" Checked="SaturdaySelection_Changed" Unchecked="SaturdaySelection_Changed" />
                            <CheckBox x:Name="MissionsQuarterly" Content="Trimestre inteiro" IsChecked="True" Unchecked="QuarterlySelection_Unchecked" Margin="0,7,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource Brush.SurfaceRaised}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Provai e Vede" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" />
                            <TextBlock Text="Site oficial do programa" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12" Margin="0,3,0,6" />
                            <TextBox x:Name="ProvaiUrl" Padding="8" />
                            <Separator Margin="0,14,0,12" Background="{DynamicResource Brush.Border}" />
                            <TextBlock Text="Vídeos a baixar" Foreground="{DynamicResource Brush.TextPrimary}" FontWeight="SemiBold" />
                            <TextBlock Text="Marque os sábados desejados. Sem seleção, o trimestre inteiro será baixado." Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12" Margin="0,3,0,6" TextWrapping="Wrap" />
                            <CheckBox x:Name="ProvaiPreviousSaturday" Content="Sábado anterior" Checked="SaturdaySelection_Changed" Unchecked="SaturdaySelection_Changed" />
                            <CheckBox x:Name="ProvaiCurrentSaturday" Content="Sábado atual" Checked="SaturdaySelection_Changed" Unchecked="SaturdaySelection_Changed" />
                            <CheckBox x:Name="ProvaiNextSaturday" Content="Próximo sábado" Checked="SaturdaySelection_Changed" Unchecked="SaturdaySelection_Changed" />
                            <CheckBox x:Name="ProvaiQuarterly" Content="Trimestre inteiro" IsChecked="True" Unchecked="QuarterlySelection_Unchecked" Margin="0,7,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource Brush.SurfaceRaised}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Minuto de Saúde" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" />
                            <TextBlock Text="Site oficial do programa" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12" Margin="0,3,0,6" />
                            <TextBox x:Name="HealthUrl" Padding="8" />
                            <Separator Margin="0,14,0,12" Background="{DynamicResource Brush.Border}" />
                            <TextBlock Text="Vídeos a baixar" Foreground="{DynamicResource Brush.TextPrimary}" FontWeight="SemiBold" />
                            <TextBlock Text="Marque os sábados desejados. Sem seleção, o trimestre inteiro será baixado." Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12" Margin="0,3,0,6" TextWrapping="Wrap" />
                            <CheckBox x:Name="HealthPreviousSaturday" Content="Sábado anterior" Checked="SaturdaySelection_Changed" Unchecked="SaturdaySelection_Changed" />
                            <CheckBox x:Name="HealthCurrentSaturday" Content="Sábado atual" Checked="SaturdaySelection_Changed" Unchecked="SaturdaySelection_Changed" />
                            <CheckBox x:Name="HealthNextSaturday" Content="Próximo sábado" Checked="SaturdaySelection_Changed" Unchecked="SaturdaySelection_Changed" />
                            <CheckBox x:Name="HealthQuarterly" Content="Trimestre inteiro" IsChecked="True" Unchecked="QuarterlySelection_Unchecked" Margin="0,7,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" IsCancel="True" Margin="0,0,8,0" Padding="16,8" />
                <Button Content="Salvar" Click="Save_Click" Padding="16,8" Style="{DynamicResource Button.Primary}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
