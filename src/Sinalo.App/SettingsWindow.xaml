<Window x:Class="Sinalo.App.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Configurar fontes" Width="620" SizeToContent="Height" WindowStartupLocation="CenterOwner" Background="{DynamicResource Brush.Window}">
    <Border Margin="18" Padding="24" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="10"><StackPanel><TextBlock Text="Fontes de conteúdo" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}"/><TextBlock Text="Informe a página ou canal oficial de cada fonte." Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,4,0,20"/><TextBlock Text="Informativo das Missões" Foreground="{DynamicResource Brush.TextPrimary}"/><TextBox x:Name="MissionsUrl" Margin="0,6,0,16" Padding="8"/><TextBlock Text="Provai e Vede" Foreground="{DynamicResource Brush.TextPrimary}"/><TextBox x:Name="ProvaiUrl" Margin="0,6,0,8" Padding="8"/>
            <TextBlock Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12"><Run Text="Como sincronizar"/><Run Language="pt-br" Text=" Provai e Vede"/></TextBlock>
            <ComboBox x:Name="ProvaiPolicy" Margin="0,4,0,16" Padding="8"><ComboBoxItem Content="Trimestre completo"/><ComboBoxItem Content="Sábado anterior, atual e próximo"/></ComboBox><TextBlock Text="Minuto de Saúde" Foreground="{DynamicResource Brush.TextPrimary}"/><TextBox x:Name="HealthUrl" Margin="0,6,0,8" Padding="8"/><TextBlock Text="Como sincronizar Minuto de Saúde" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12"/><ComboBox x:Name="HealthPolicy" Margin="0,4,0,24" Padding="8"><ComboBoxItem Content="Trimestre completo"/><ComboBoxItem Content="Sábado anterior, atual e próximo"/></ComboBox><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancelar" IsCancel="True" Margin="0,0,8,0" Padding="16,8"/><Button Content="Salvar" Click="Save_Click" Padding="16,8" Style="{DynamicResource Button.Primary}"/></StackPanel></StackPanel></Border>
</Window>
