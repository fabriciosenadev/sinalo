<UserControl x:Class="Sinalo.App.LibraryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" SizeChanged="Workspace_SizeChanged" Loaded="Workspace_Loaded" FontSize="14" Foreground="{DynamicResource Brush.TextPrimary}">
<UserControl.Resources>
<BooleanToVisibilityConverter x:Key="BoolVisibility"/>
<Style x:Key="Library.Tab" TargetType="RadioButton"><Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Tab" Padding="18,12" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,3"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Tab" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/><Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tab" Property="Background" Value="{DynamicResource Brush.SurfaceRaised}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tab" Property="BorderBrush" Value="{DynamicResource Brush.Focus}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style x:Key="Library.Row" TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="14,12"/><Setter Property="MinHeight" Value="66"/><Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" Background="Transparent" Padding="{TemplateBinding Padding}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.SurfaceRaised}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.ButtonHover}"/><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/><Setter TargetName="Row" Property="BorderThickness" Value="3,0,0,1"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Brush.Focus}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style x:Key="Library.Option" TargetType="RadioButton"><Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/><Setter Property="Margin" Value="0,12,0,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition/></Grid.ColumnDefinitions><Border x:Name="Circle" Width="18" Height="18" CornerRadius="9" VerticalAlignment="Top" BorderThickness="1" BorderBrush="{DynamicResource Brush.ButtonBorder}" Background="{DynamicResource Brush.Input}"><Ellipse x:Name="Mark" Margin="3" Fill="{DynamicResource Brush.Accent}" Visibility="Collapsed"/></Border><ContentPresenter Grid.Column="1"/></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Mark" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Circle" Property="BorderBrush" Value="{DynamicResource Brush.Focus}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
</UserControl.Resources>
<Grid>
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
<WrapPanel x:Name="LibraryHeader" Margin="0,0,0,14">
<StackPanel Margin="0,0,28,6"><TextBlock x:Name="LibraryTitle" Text="Biblioteca de vídeos" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="{Binding CountLabel}" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,4,0,0"/></StackPanel>
<Expander x:Name="OutputOptions" Header="Tela de saída" IsExpanded="True" Width="220" Margin="0,0,0,6" Foreground="{DynamicResource Brush.TextPrimary}"><ComboBox x:Name="LibraryOutputScreen" MinHeight="36" Padding="8" ItemsSource="{Binding DataContext.PlaybackScreens, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding DataContext.SelectedPlaybackScreen, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}" SelectionChanged="OutputScreen_SelectionChanged" AutomationProperties.Name="Tela de saída dos vídeos"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></Expander>
</WrapPanel>
<Border x:Name="TabBar" Grid.Row="1" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Margin="0,0,0,16"><WrapPanel><RadioButton x:Name="VideosTab" Content="Vídeos" GroupName="LibraryTabs" Style="{StaticResource Library.Tab}" IsChecked="{Binding ShowVideos, Mode=OneWay}" Command="{Binding ShowVideoListCommand}"/><RadioButton x:Name="ImportTab" Content="Importar vídeos" GroupName="LibraryTabs" Style="{StaticResource Library.Tab}" IsChecked="{Binding IsImportTab, Mode=OneWay}" Command="{Binding ShowImportsCommand}"/></WrapPanel></Border>
<StackPanel Grid.Row="2">
<WrapPanel><Button Content="Importação em andamento · Acompanhar" Command="{Binding ShowImportsCommand}" Padding="12,8" Margin="0,0,8,10" Visibility="{Binding IsImporting, Converter={StaticResource BoolVisibility}}"/><Button Content="Downloads · Acompanhar fila" Click="Queue_Click" Padding="12,8" Margin="0,0,8,10" Visibility="{Binding DataContext.HasSynchronizationQueueItems, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVisibility}}"/></WrapPanel>
<Border Padding="12" CornerRadius="8" Background="{DynamicResource Brush.SurfaceRaised}" Margin="0,0,0,12" Visibility="{Binding PresentationIsOpen, Converter={StaticResource BoolVisibility}}"><WrapPanel><TextBlock Text="Feche a apresentação antes de reproduzir um vídeo." TextWrapping="Wrap" Margin="0,6,12,6"/><Button Content="Fechar apresentação" Click="ClosePresentation_Click" Padding="12,8"/></WrapPanel></Border>
</StackPanel>
<Grid Grid.Row="3" x:Name="VideosWorkspace" Visibility="{Binding ShowVideos, Converter={StaticResource BoolVisibility}}">
<Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition x:Name="DetailsColumn" Width="0"/></Grid.ColumnDefinitions>
<Grid x:Name="VideoListRegion" Visibility="{Binding ShowList, Converter={StaticResource BoolVisibility}}">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Expander x:Name="FilterOptions" Header="Pesquisa e filtros" IsExpanded="True" Margin="0,0,0,8" Foreground="{DynamicResource Brush.TextPrimary}">
<WrapPanel x:Name="FilterBar" Margin="0,8,0,14">
<StackPanel Margin="0,0,10,6"><Label Content="Pesquisar por nome ou data" Target="{Binding ElementName=SearchInput}" Padding="0,0,0,5" Foreground="{DynamicResource Brush.TextSecondary}"/><TextBox x:Name="SearchInput" Width="200" MinHeight="36" Padding="8" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Nome ou DD/MM/AAAA"><TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SearchNowCommand}"/></TextBox.InputBindings></TextBox></StackPanel>
<StackPanel Margin="0,0,10,6" Visibility="{Binding ShowFilters, Converter={StaticResource BoolVisibility}}"><Label Content="Origem" Target="{Binding ElementName=OriginInput}" Padding="0,0,0,5" Foreground="{DynamicResource Brush.TextSecondary}"/><ComboBox x:Name="OriginInput" Width="180" MinHeight="36" Padding="8" ItemsSource="{Binding Origins}" SelectedItem="{Binding Origin}"/></StackPanel>
<StackPanel Margin="0,0,10,6" Visibility="{Binding ShowFilters, Converter={StaticResource BoolVisibility}}"><Label Content="Ordenar por" Target="{Binding ElementName=SortInput}" Padding="0,0,0,5" Foreground="{DynamicResource Brush.TextSecondary}"/><ComboBox x:Name="SortInput" Width="145" MinHeight="36" Padding="8" ItemsSource="{Binding Sorts}" SelectedItem="{Binding Sort}"/></StackPanel>
<Button Content="Filtros" Visibility="{Binding ShowCompactRows, Converter={StaticResource BoolVisibility}}" Command="{Binding ToggleFiltersCommand}" VerticalAlignment="Bottom" Padding="12,8" Margin="0,0,8,6"/><Button Content="Pesquisar" Command="{Binding SearchNowCommand}" VerticalAlignment="Bottom" Padding="12,8" Margin="0,0,8,6"/><Button Content="Atualizar lista" Command="{Binding RefreshCommand}" VerticalAlignment="Bottom" Padding="12,8" Margin="0,0,0,6"/>
</WrapPanel>
</Expander>
<Border Grid.Row="1" Background="{DynamicResource Brush.SurfaceRaised}" Padding="14,10,28,10" CornerRadius="6,6,0,0" Visibility="{Binding ShowColumnHeaders, Converter={StaticResource BoolVisibility}}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="170"/><ColumnDefinition Width="104"/><ColumnDefinition Width="164"/></Grid.ColumnDefinitions><TextBlock Text="Vídeo" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="Origem"/><TextBlock Grid.Column="2" Text="Data de uso"/><TextBlock Grid.Column="3" Text="Disponibilidade"/></Grid></Border>
<ListBox x:Name="MediaList" Grid.Row="2" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected, Mode=OneWay}" SelectionChanged="MediaList_SelectionChanged" ItemContainerStyle="{StaticResource Library.Row}" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" AutomationProperties.Name="Vídeos da biblioteca">
<ListBox.ItemTemplate><DataTemplate><Grid>
<Grid Visibility="{Binding DataContext.ShowColumnHeaders, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolVisibility}}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="170"/><ColumnDefinition Width="104"/><ColumnDefinition Width="164"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="44" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" Margin="0,0,16,0"/><TextBlock Grid.Column="1" Text="{Binding OriginLabel}" FontSize="13" TextWrapping="Wrap" Margin="0,0,10,0" Foreground="{DynamicResource Brush.TextSecondary}"/><TextBlock Grid.Column="2" Text="{Binding UsageDate, StringFormat={}{0:dd/MM/yyyy}, TargetNullValue=Sem data de uso}" FontSize="13" Foreground="{DynamicResource Brush.TextSecondary}"/><TextBlock Grid.Column="3" Text="{Binding AvailabilityLabel}" FontSize="13" TextWrapping="Wrap"/></Grid>
<StackPanel Visibility="{Binding DataContext.ShowCompactRows, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolVisibility}}"><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="44" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/><WrapPanel Margin="0,5,0,0"><TextBlock Text="{Binding OriginLabel, StringFormat=Origem: {0}}" FontSize="13" Margin="0,0,16,4" Foreground="{DynamicResource Brush.TextSecondary}"/><TextBlock Text="{Binding UsageDate, StringFormat=Data: {0:dd/MM/yyyy}, TargetNullValue=Sem data de uso}" FontSize="13" Margin="0,0,16,4" Foreground="{DynamicResource Brush.TextSecondary}"/><TextBlock Text="{Binding AvailabilityLabel}" FontSize="13"/></WrapPanel></StackPanel>
</Grid></DataTemplate></ListBox.ItemTemplate>
</ListBox>
<StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Margin="20" Visibility="{Binding ShowEmpty, Converter={StaticResource BoolVisibility}}"><TextBlock Text="{Binding EmptyTitle}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"/><TextBlock Text="{Binding EmptyDescription}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12" Foreground="{DynamicResource Brush.TextSecondary}"/><WrapPanel HorizontalAlignment="Center"><Button Content="Importar vídeos" Command="{Binding ShowImportsCommand}" Padding="14,9" Margin="4"/><Button Content="Limpar filtros" Command="{Binding ClearFiltersCommand}" Padding="14,9" Margin="4"/></WrapPanel></StackPanel>
<StackPanel x:Name="ListFooter" Grid.Row="3" Margin="0,12,0,0"><WrapPanel><Button Content="Anterior" Command="{Binding PreviousPageCommand}" IsEnabled="{Binding CanPrevious}" Padding="12,8"/><TextBlock Text="{Binding PageLabel}" VerticalAlignment="Center" Margin="14,0"/><Button Content="Próxima" Command="{Binding NextPageCommand}" IsEnabled="{Binding CanNext}" Padding="12,8"/><Button Content="Ver detalhes do vídeo" Command="{Binding ShowDetailsPanelCommand}" IsEnabled="{Binding HasSelection}" Padding="12,8" Margin="16,0,0,0"/></WrapPanel><TextBlock Text="{Binding ActionMessage}" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{DynamicResource Brush.TextSecondary}"/></StackPanel>
</Grid>
<Border x:Name="DetailsRegion" Grid.Column="1" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="10" Padding="18" Visibility="{Binding ShowDetails, Converter={StaticResource BoolVisibility}}">
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Button Grid.Row="0" Content="← Voltar aos vídeos" Command="{Binding CloseDetailsCommand}" Padding="10,7" HorizontalAlignment="Left" Margin="0,0,0,12"/>
<Button Grid.Row="2" Content="{Binding PlayLabel}" Command="{Binding PlayCommand}" IsEnabled="{Binding CanPlaySelected}" Padding="12,10" Style="{DynamicResource Button.Primary}" HorizontalContentAlignment="Center" Margin="0,12,0,0"/>
<ScrollViewer x:Name="DetailsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0"><StackPanel><TextBlock Text="{Binding Selected.Name}" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Selected.OriginLabel}" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,6,0,18"/><TextBlock Text="{Binding ActionMessage}" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{DynamicResource Brush.TextSecondary}"/><Button Content="Localizar arquivo ausente" Click="Locate_Click" Padding="12,8" HorizontalAlignment="Left" Margin="0,0,0,16" Visibility="{Binding NeedsLocate, Converter={StaticResource BoolVisibility}}"/>
<TextBlock Text="Informações do vídeo" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12"/>
<TextBlock Text="Disponibilidade" Foreground="{DynamicResource Brush.TextSecondary}"/><TextBlock Text="{Binding Selected.AvailabilityLabel}" TextWrapping="Wrap" Margin="0,3,0,12"/>
<TextBlock Text="Data de uso" Foreground="{DynamicResource Brush.TextSecondary}"/><TextBlock Text="{Binding UsageDateLabel}" Margin="0,3,0,12"/>
<TextBlock Text="Armazenamento" Foreground="{DynamicResource Brush.TextSecondary}"/><TextBlock Text="{Binding Selected.StorageLabel}" TextWrapping="Wrap" Margin="0,3,0,12"/>
<TextBlock Text="Histórico" Foreground="{DynamicResource Brush.TextSecondary}"/><TextBlock Text="{Binding PlaybackCountLabel}" Margin="0,3,0,16"/>
<Button Content="Editar informações" Command="{Binding EditInformationCommand}" Padding="12,8" HorizontalAlignment="Left" Visibility="{Binding ShowReading, Converter={StaticResource BoolVisibility}}"/>
<StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BoolVisibility}}"><Label Content="Nome exibido" Target="{Binding ElementName=EditNameInput}" Padding="0,0,0,5" Foreground="{DynamicResource Brush.TextPrimary}"/><TextBox x:Name="EditNameInput" MinHeight="36" Padding="8" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"/><StackPanel Visibility="{Binding IsImported, Converter={StaticResource BoolVisibility}}" Margin="0,12,0,0"><Label Content="Data opcional (DD/MM/AAAA)" Target="{Binding ElementName=EditDateInput}" Padding="0,0,0,5" Foreground="{DynamicResource Brush.TextPrimary}"/><TextBox x:Name="EditDateInput" MinHeight="36" Padding="8" Text="{Binding EditDate, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><WrapPanel Margin="0,12,0,0"><Button Content="Salvar" Command="{Binding SaveNameCommand}" Padding="12,8" Margin="0,0,8,6"/><Button Content="Cancelar" Command="{Binding CancelEditingCommand}" Padding="12,8" Margin="0,0,0,6"/></WrapPanel></StackPanel>
<Expander Header="Localização do arquivo" Margin="0,20,0,0" Foreground="{DynamicResource Brush.TextPrimary}"><TextBox Text="{Binding Selected.LocalPath, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0,10"/></Expander>
<Button Content="Localizar arquivo" Click="Locate_Click" Padding="12,8" HorizontalAlignment="Left" Margin="0,12,0,0"/>
<StackPanel Visibility="{Binding IsProgramVideo, Converter={StaticResource BoolVisibility}}" Margin="0,18,0,0"><TextBlock Text="Fixação protege o vídeo da limpeza automática." TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}"/><Button Content="{Binding PinLabel}" Command="{Binding TogglePinCommand}" Padding="12,8" HorizontalAlignment="Left" Margin="0,8,0,0"/></StackPanel>
<Separator Margin="0,22,0,18"/><TextBlock Text="Remoção" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding RemovalExplanation}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,8,0,12"/><CheckBox Content="Excluir também a cópia do Sinalo" IsChecked="{Binding DeleteCopy}" Visibility="{Binding CanDeleteCopy, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,12"/><Button Content="{Binding RemoveLabel}" Click="Remove_Click" Padding="12,8" HorizontalAlignment="Left"/><TextBlock Text="{Binding ActionMessage}" TextWrapping="Wrap" Margin="0,16,0,0" Foreground="{DynamicResource Brush.TextSecondary}"/>
</StackPanel></ScrollViewer>
</Grid></Border>
</Grid>
<ScrollViewer Grid.Row="3" x:Name="ImportWorkspace" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding IsImportTab, Converter={StaticResource BoolVisibility}}" Padding="0,0,10,0"><StackPanel MaxWidth="800" HorizontalAlignment="Left">
<TextBlock Text="Adicione vídeos deste computador" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Escolha arquivos MP4 ou uma pasta. Não é necessário definir programa ou data." TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,8,0,20"/>
<Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,20"><StackPanel IsEnabled="{Binding CanImport}"><TextBlock Text="1. Onde os vídeos ficarão?" FontSize="18" FontWeight="SemiBold"/>
<RadioButton GroupName="LibraryStorage" AutomationProperties.Name="Copiar para o Sinalo" Style="{StaticResource Library.Option}" IsChecked="{Binding CopyIntoSinalo}"><StackPanel><TextBlock Text="Copiar para o Sinalo" FontWeight="SemiBold"/><TextBlock Text="Recomendado. O original é preservado." TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,5,0,0"/></StackPanel></RadioButton>
<RadioButton GroupName="LibraryStorage" AutomationProperties.Name="Manter no local original" Style="{StaticResource Library.Option}" IsChecked="{Binding UseOriginal}"><StackPanel><TextBlock Text="Manter no local original" FontWeight="SemiBold"/><TextBlock Text="Não copia. O arquivo ou pendrive precisa continuar acessível." TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,5,0,0"/></StackPanel></RadioButton>
<TextBlock Text="Pasta de conteúdo do Sinalo" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,18,0,4"/><TextBlock Text="{Binding ContentFolder}" TextWrapping="Wrap"/>
</StackPanel></Border>
<Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,20"><StackPanel IsEnabled="{Binding CanImport}"><TextBlock Text="2. Escolha os vídeos" FontSize="18" FontWeight="SemiBold"/><WrapPanel Margin="0,16,0,12"><Button Content="Escolher arquivos MP4" Click="AddFiles_Click" Padding="14,10" Style="{DynamicResource Button.Primary}" Margin="0,0,10,8"/><Button Content="Escolher pasta" Click="AddFolder_Click" Padding="14,10" Margin="0,0,0,8"/></WrapPanel><CheckBox Content="Incluir subpastas ao escolher uma pasta" IsChecked="{Binding IncludeSubfolders}"/><TextBlock Text="Ao confirmar a seleção, a importação começa." TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,12,0,0"/></StackPanel></Border>
<Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="10" Padding="20"><StackPanel><TextBlock Text="Andamento e resultado" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding ImportMessage}" TextWrapping="Wrap" Margin="0,12,0,0"/><ProgressBar Minimum="0" Maximum="100" Height="8" Value="{Binding Progress}" Margin="0,14,0,0" Visibility="{Binding IsImporting, Converter={StaticResource BoolVisibility}}"/><Button Content="Cancelar importação" Command="{Binding CancelImportCommand}" Padding="12,8" HorizontalAlignment="Left" Margin="0,14,0,0" Visibility="{Binding IsImporting, Converter={StaticResource BoolVisibility}}"/>
<StackPanel Visibility="{Binding HasImportResult, Converter={StaticResource BoolVisibility}}"><WrapPanel Margin="0,18,0,0"><StackPanel Margin="0,0,28,12"><TextBlock Text="{Binding ImportedCount}" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Importados"/></StackPanel><StackPanel Margin="0,0,28,12"><TextBlock Text="{Binding ExistingCount}" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Já existentes"/></StackPanel><StackPanel Margin="0,0,28,12"><TextBlock Text="{Binding IgnoredCount}" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Ignorados"/></StackPanel><StackPanel Margin="0,0,0,12"><TextBlock Text="{Binding FailedCount}" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Falhas"/></StackPanel></WrapPanel><Expander Header="Detalhes das falhas" Visibility="{Binding HasImportFailures, Converter={StaticResource BoolVisibility}}" Foreground="{DynamicResource Brush.TextPrimary}"><TextBlock Text="{Binding ImportFailures}" TextWrapping="Wrap" Margin="0,10"/></Expander><Button Content="Ir para vídeos" Command="{Binding ShowVideoListCommand}" Padding="12,8" HorizontalAlignment="Left" Margin="0,14,0,0"/></StackPanel>
</StackPanel></Border>
</StackPanel></ScrollViewer>
</Grid>
</UserControl>
