<Window
  Style="{DynamicResource {x:Type Window}}"
  x:Class="Sinalo.App.SessionScheduleWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Programação desta sessão"
  Width="680"
  Height="500"
  WindowStartupLocation="CenterOwner"
  Background="{DynamicResource Brush.Window}">
  <Window.Resources>
    <BooleanToVisibilityConverter
      x:Key="BooleanToVisibilityConverter" />
  </Window.Resources>
  <Grid
    Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition
        Height="Auto" />
      <RowDefinition
        Height="Auto" />
      <RowDefinition
        Height="*" />
      <RowDefinition
        Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock
      Text="Programação desta sessão"
      Style="{DynamicResource Text.Heading}" />
    <TextBlock
      Grid.Row="1"
      Text="Mantida enquanto o Sinalo está aberto. Remover daqui não exclui o arquivo."
      Margin="0,0,0,16" />
    <ListBox
      Grid.Row="2"
      ItemsSource="{Binding ScheduleItems}"
      Background="{DynamicResource Brush.Surface}"
      HorizontalContentAlignment="Stretch">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Border
            Padding="12">
            <StackPanel>
              <TextBlock
                Text="{Binding Position, StringFormat=Posição {0}}"
                Foreground="{DynamicResource Brush.TextSecondary}" />
              <TextBlock
                Text="{Binding Title}"
                FontSize="16"
                FontWeight="SemiBold" />
              <TextBlock
                Text="{Binding SourceName}" />
              <WrapPanel
                Margin="0,8,0,0">
                <Button
                  Content="Mover para cima"
                  IsEnabled="{Binding CanMoveUp}"
                  Tag="{Binding}"
                  Click="Up_Click"
                  Margin="0,0,8,8"
                  VerticalAlignment="Center" />
                <Button
                  Content="Mover para baixo"
                  IsEnabled="{Binding CanMoveDown}"
                  Tag="{Binding}"
                  Click="Down_Click"
                  Margin="0,0,8,8"
                  VerticalAlignment="Center" />
                <Button
                  Content="Remover da programação"
                  Tag="{Binding}"
                  Click="Remove_Click"
                  Margin="0,0,8,8"
                  VerticalAlignment="Center" />
              </WrapPanel>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <TextBlock
      Grid.Row="2"
      Text="Nenhum vídeo na programação. Selecione um vídeo no programa e escolha Adicionar à programação."
      VerticalAlignment="Center"
      TextWrapping="Wrap"
      Visibility="{Binding IsScheduleEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />
    <Button
      Grid.Row="3"
      Content="Fechar"
      IsCancel="True"
      HorizontalAlignment="Right"
      Margin="0,16,0,0" />
  </Grid>
</Window>