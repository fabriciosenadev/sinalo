<Window
  Style="{DynamicResource {x:Type Window}}"
  x:Class="Sinalo.App.HealthYouTubeWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Minuto de Saúde — YouTube"
  Width="840" Height="740" MinWidth="520" MinHeight="440"
  WindowStartupLocation="CenterOwner"
  Background="{DynamicResource Brush.Window}">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
  </Window.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,16">
      <TextBlock Text="Vídeos recentes do YouTube" Style="{DynamicResource Text.Heading}" TextWrapping="Wrap" />
      <TextBlock Text="{Binding ChannelName}" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" />
      <TextBlock Text="{Binding PolicyLabel}" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" Margin="0,6,0,0" />
    </StackPanel>
    <Border Grid.Row="1" Style="{DynamicResource Surface.Section}" Padding="16" Margin="0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel LastChildFill="True" Margin="0,0,0,8">
          <Button x:Name="RefreshVideosButton" DockPanel.Dock="Right" Content="{Binding RefreshCaption}"
                  Click="Refresh_Click" IsEnabled="{Binding CanRefresh}" Margin="12,0,0,0" />
          <TextBlock Text="Escolha os vídeos" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
        </DockPanel>
        <TextBlock Grid.Row="1" Text="{Binding Message}" Foreground="{DynamicResource Brush.TextSecondary}"
                   TextWrapping="Wrap" Margin="0,0,0,12" AutomationProperties.LiveSetting="Polite" />
        <Border x:Name="SearchBusyPanel" Grid.Row="2" Background="{DynamicResource Brush.SurfaceRaised}"
                CornerRadius="6" Padding="16"
                Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="Buscando vídeos no YouTube…" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
            <ProgressBar x:Name="SearchProgress" Grid.Row="1" Height="8" Margin="0,12,0,10"
                         IsIndeterminate="{Binding IsBusy}" AutomationProperties.Name="Busca de vídeos em andamento" />
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <TextBlock Text="Conferindo publicações e disponibilidade. Nenhum download foi iniciado."
                         Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" />
            </ScrollViewer>
          </Grid>
        </Border>
        <ScrollViewer x:Name="VideosScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,12,0" Visibility="{Binding HasResults, Converter={StaticResource BooleanToVisibilityConverter}}">
          <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{DynamicResource Brush.SurfaceRaised}" BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,8">
                  <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanSelect}"
                            HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding Title}" Margin="0">
                    <StackPanel Margin="8,0,0,0">
                      <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontSize="16" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding PublicationLabel}" Foreground="{DynamicResource Brush.TextSecondary}"
                                 TextWrapping="Wrap" Margin="0,6,0,0" />
                      <WrapPanel Margin="0,6,0,0">
                        <TextBlock Text="{Binding EpisodeLabel}" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,12,0" />
                        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
                      </WrapPanel>
                    </StackPanel>
                  </CheckBox>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <StackPanel Grid.Row="2" VerticalAlignment="Center" Margin="16"
                    Visibility="{Binding ShowEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}">
          <TextBlock Text="Nenhum vídeo para selecionar" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="Confira a mensagem acima. Você pode atualizar a lista para tentar novamente."
                     Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel>
      </Grid>
    </Border>
    <StackPanel Grid.Row="2" Margin="0,16,0,0">
      <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
      <TextBlock Text="Publicação não é data de uso no culto. Os vídeos já baixados são preservados."
                 Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" Margin="0,6,0,0" />
      <WrapPanel HorizontalAlignment="Right" Margin="0,16,0,0">
        <Button Content="Cancelar" IsCancel="True" Margin="0,0,8,8" />
        <Button x:Name="ApproveVideosButton" Content="{Binding ApprovalCaption}" IsEnabled="{Binding CanApprove}"
                Click="Approve_Click" Style="{DynamicResource Button.Primary}" Margin="0,0,0,8" />
      </WrapPanel>
    </StackPanel>
  </Grid>
</Window>
