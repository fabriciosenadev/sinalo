<Window
  Style="{DynamicResource {x:Type Window}}"
  x:Class="Sinalo.App.DownloadsWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Downloads"
  Width="680"
  Height="540"
  MinWidth="460"
  MinHeight="340"
  WindowStartupLocation="CenterOwner"
  Background="{DynamicResource Brush.Window}">
  <Window.Resources>
    <BooleanToVisibilityConverter
      x:Key="BooleanToVisibilityConverter" />
  </Window.Resources>
  <Grid
    Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition
        Height="Auto" />
      <RowDefinition
        Height="Auto" />
      <RowDefinition
        Height="*" />
      <RowDefinition
        Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock
      Text="Downloads desta sessão"
      Style="{DynamicResource Text.Heading}" />
    <StackPanel
      Grid.Row="1"
      Margin="0,0,0,16">
      <TextBlock
        Text="{Binding SynchronizationMessage}" />
      <ProgressBar
        Height="8"
        Value="{Binding SyncProgressPercent}"
        IsIndeterminate="{Binding IsSynchronizationIndeterminate}"
        Maximum="100"
        Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
        Margin="0,8,0,0" />
      <TextBlock
        Text="Cancelar interrompe o pedido ativo e os que estão aguardando."
        FontSize="13"
        Margin="0,8,0,0" />
    </StackPanel>
    <ListBox
      Grid.Row="2"
      ItemsSource="{Binding SynchronizationQueueItems}"
      Background="{DynamicResource Brush.Surface}"
      HorizontalContentAlignment="Stretch"
      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Border
            Padding="12"
            Margin="0,0,0,8"
            Background="{DynamicResource Brush.SurfaceRaised}">
            <StackPanel>
              <TextBlock
                Text="{Binding SourceName}"
                FontSize="16"
                FontWeight="SemiBold" />
              <TextBlock
                Text="{Binding State}"
                Foreground="{DynamicResource Brush.Accent}"
                Margin="0,4,0,4" />
              <TextBlock
                Text="{Binding Details}" />
              <Button
                Content="O que aconteceu?"
                Tag="{Binding Diagnostic}"
                Click="Diagnostic_Click"
                Visibility="{Binding HasDiagnostic, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <WrapPanel
      Grid.Row="3"
      HorizontalAlignment="Right"
      Margin="0,16,0,0">
      <Button
        Content="Cancelar todos os downloads"
        IsEnabled="{Binding IsQueueActive}"
        Click="Cancel_Click"
        Margin="0,0,8,8"
        VerticalAlignment="Center" />
      <Button
        Content="Fechar"
        IsCancel="True"
        Margin="0,0,8,8"
        VerticalAlignment="Center" />
    </WrapPanel>
  </Grid>
</Window>